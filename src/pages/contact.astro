---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout
  title="Contact | Andres Provero"
  description="Contact Andres Provero — Electronics Engineer and Technical Operations Leader in Mexico City."
>
  <main class="max-w-4xl mx-auto px-6 sm:px-10 py-12 sm:py-24 space-y-12">
    
    <header class="space-y-4 border-b border-border-light/80 dark:border-border-dark/80 pb-10">
      <div class="font-mono text-xs sm:text-sm text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
        DIRECT CONTACT
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink-light dark:text-ink-dark">
        Get in Touch
      </h1>
      <p class="text-lg sm:text-xl text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed max-w-2xl">
        If you want to talk about engineering, energy infrastructure, technical operations, technology, or something interesting enough to build, feel free to reach out.
      </p>
    </header>

    <div class="space-y-8 max-w-2xl">
      
      <!-- Primary Email -->
      <div class="space-y-2">
        <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted uppercase">
          PRIMARY EMAIL
        </div>
        <div>
          <a
            href={siteConfig.socials.email.href}
            class="text-2xl sm:text-3xl font-bold font-mono text-accent-dark dark:text-accent hover:underline break-all"
          >
            {siteConfig.email}
          </a>
        </div>
        <p class="text-sm text-ink-light-muted dark:text-ink-dark-muted">
          Direct inbox for advisory, technical inquiries, and engineering correspondence.
        </p>
      </div>

      <!-- Professional Profiles -->
      <div class="pt-6 border-t border-border-light/80 dark:border-border-dark/80 flex flex-wrap gap-8 text-base font-mono">
        <a
          href={siteConfig.socials.linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-dark dark:hover:text-accent inline-flex items-center gap-1.5 transition-colors"
        >
          <span>LinkedIn</span>
          <span>↗</span>
        </a>

        <a
          href={siteConfig.socials.github.href}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-dark dark:hover:text-accent inline-flex items-center gap-1.5 transition-colors"
        >
          <span>GitHub</span>
          <span>↗</span>
        </a>
      </div>

      <!-- Location & Timezone Details -->
      <div class="pt-6 border-t border-border-light/80 dark:border-border-dark/80 font-mono text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-ink-light dark:text-ink-dark font-medium">Location:</span> {siteConfig.location}
        </div>
        <div>
          <span class="text-ink-light dark:text-ink-dark font-medium">Timezone:</span> {siteConfig.timezone} (Central Standard Time)
        </div>
      </div>

    </div>

  </main>
</BaseLayout>