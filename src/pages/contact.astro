---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout
  title="Contact | Andres Provero"
  description="Contact Andres Provero — Electronics Engineer and Technical Operations Leader in Mexico City."
>
  <main class="max-w-2xl mx-auto px-5 sm:px-8 py-10 sm:py-20 space-y-10">
    
    <header class="space-y-3 border-b border-border-light dark:border-border-dark pb-8">
      <div class="font-mono text-xs text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
        DIRECT CONTACT
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-light dark:text-ink-dark">
        Get in Touch
      </h1>
      <p class="text-base sm:text-lg text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed">
        If you want to talk about engineering, energy infrastructure, technical operations, technology, or something interesting enough to build, feel free to reach out.
      </p>
    </header>

    <div class="space-y-6">
      
      <!-- Primary Email -->
      <div class="p-6 rounded-lg border border-border-light dark:border-border-dark bg-surface-light-card dark:bg-surface-dark-card space-y-3">
        <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
          PRIMARY EMAIL
        </div>
        <div>
          <a
            href={siteConfig.socials.email.href}
            class="text-xl sm:text-2xl font-bold font-mono text-accent-dark dark:text-accent hover:underline break-all"
          >
            {siteConfig.email}
          </a>
        </div>
        <p class="text-xs text-ink-light-muted dark:text-ink-dark-muted font-mono">
          Direct inbox for advisory, engineering inquiries, and technical correspondence.
        </p>
      </div>

      <!-- Professional Profiles -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <a
          href={siteConfig.socials.linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-lg border border-border-light dark:border-border-dark bg-surface-light-card dark:bg-surface-dark-card hover:border-accent/40 transition-colors space-y-2 group"
        >
          <div class="flex items-center justify-between">
            <span class="font-semibold text-ink-light dark:text-ink-dark text-sm">LinkedIn</span>
            <span class="text-accent-dark dark:text-accent font-mono text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
          </div>
          <p class="text-xs text-ink-light-muted dark:text-ink-dark-muted font-mono">
            linkedin.com/in/aprovero
          </p>
        </a>

        <a
          href={siteConfig.socials.github.href}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-lg border border-border-light dark:border-border-dark bg-surface-light-card dark:bg-surface-dark-card hover:border-accent/40 transition-colors space-y-2 group"
        >
          <div class="flex items-center justify-between">
            <span class="font-semibold text-ink-light dark:text-ink-dark text-sm">GitHub</span>
            <span class="text-accent-dark dark:text-accent font-mono text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
          </div>
          <p class="text-xs text-ink-light-muted dark:text-ink-dark-muted font-mono">
            github.com/aprovero
          </p>
        </a>

      </div>

      <!-- Location & Timezone Details -->
      <div class="pt-4 border-t border-border-light dark:border-border-dark font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <span class="text-ink-light dark:text-ink-dark font-medium">Location:</span> {siteConfig.location}
        </div>
        <div>
          <span class="text-ink-light dark:text-ink-dark font-medium">Timezone:</span> {siteConfig.timezone} (Central Standard Time)
        </div>
      </div>

    </div>

  </main>
</BaseLayout>