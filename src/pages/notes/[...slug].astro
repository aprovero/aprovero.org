---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const noteEntries = await getCollection('notes');
  return noteEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = new Date(entry.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${entry.data.title} | Andres Provero`}
  description={entry.data.summary}
  articleDate={entry.data.date}
>
  <main class="max-w-6xl mx-auto px-6 sm:px-10 py-12 sm:py-20 space-y-12">
    
    <!-- Navigation Back Link -->
    <nav class="font-mono text-xs sm:text-sm">
      <a
        href="/notes"
        class="text-ink-light-muted hover:text-accent-dark dark:text-ink-dark-muted dark:hover:text-accent inline-flex items-center gap-1.5 transition-colors"
      >
        <span>←</span>
        <span>Back to Notes</span>
      </a>
    </nav>

    <!-- Header Section -->
    <header class="space-y-5 border-b border-border-light/80 dark:border-border-dark/80 pb-10 max-w-[720px]">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted">
        {entry.data.draft && (
          <span class="text-amber-600 dark:text-amber-400 font-medium mr-1">
            [DRAFT]
          </span>
        )}
        <span>{formattedDate}</span>
        <span class="opacity-30">·</span>
        <span>{entry.data.readTime}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink-light dark:text-ink-dark leading-[1.18]">
        {entry.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed">
        {entry.data.summary}
      </p>

      <div class="flex flex-wrap gap-2 pt-2 text-xs font-mono text-ink-light-muted dark:text-ink-dark-muted">
        {entry.data.tags.map((tag) => (
          <span>#{tag}</span>
        ))}
      </div>
    </header>

    <!-- Narrative Prose Body -->
    <article class="prose-editorial">
      <Content />
    </article>

    <!-- Footer navigation -->
    <div class="pt-10 border-t border-border-light/80 dark:border-border-dark/80 flex items-center justify-between font-mono text-xs sm:text-sm max-w-[720px]">
      <a
        href="/notes"
        class="text-ink-light-muted hover:text-accent-dark dark:text-ink-dark-muted dark:hover:text-accent inline-flex items-center gap-1.5"
      >
        <span>←</span>
        <span>All notes</span>
      </a>

      <a
        href="#top"
        class="text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark inline-flex items-center gap-1.5"
      >
        <span>Back to top</span>
        <span>↑</span>
      </a>
    </div>

  </main>
</BaseLayout>