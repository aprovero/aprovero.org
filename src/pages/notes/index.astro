---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteRow from '@/components/NoteRow.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const sortedNotes = allNotes.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Notes & Writing | Andres Provero"
  description="Technical notes, commissioning observations, and homelab architecture write-ups by Andres Provero."
>
  <main class="max-w-6xl mx-auto px-6 sm:px-10 py-12 sm:py-20 space-y-16">
    
    <!-- Page Header -->
    <header class="space-y-4 border-b border-border-light/80 dark:border-border-dark/80 pb-10">
      <div class="font-mono text-xs sm:text-sm text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
        WRITING &amp; OBSERVATIONS
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink-light dark:text-ink-dark">
        Notes &amp; Writing
      </h1>
      <p class="text-lg sm:text-xl text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed max-w-3xl">
        Things worth documenting: observations on utility-scale engineering, field realities, hardware prototyping, and systems built to last.
      </p>
    </header>

    <!-- Notes List -->
    <div class="divide-y divide-border-light/80 dark:border-border-dark/80">
      {
        sortedNotes.map((note) => (
          <NoteRow
            title={note.data.title}
            date={note.data.date}
            summary={note.data.summary}
            tags={note.data.tags}
            draft={note.data.draft}
            readTime={note.data.readTime}
            slug={note.slug}
          />
        ))
      }
    </div>

    <!-- Back to top / home link -->
    <div class="pt-6 font-mono text-xs sm:text-sm">
      <a href="/" class="text-ink-light-muted hover:text-accent-dark dark:text-ink-dark-muted dark:hover:text-accent inline-flex items-center gap-1.5">
        <span>←</span>
        <span>Back to homepage</span>
      </a>
    </div>

  </main>
</BaseLayout>