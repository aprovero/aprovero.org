---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Archive | Andres Provero"
  description="Engineering case studies, notes, and field tools by Andres Provero."
>
  <main class="max-w-3xl mx-auto px-6 sm:px-10 py-16 sm:py-24 space-y-8">
    <header class="space-y-3 border-b border-border-light dark:border-border-dark pb-8">
      <div class="font-mono text-xs text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
        DIRECT DOCUMENTATION
      </div>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
        Case Studies &amp; Technical Notes
      </h1>
      <p class="text-base sm:text-lg text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed">
        All project architecture, commissioning methodology, and homelab documentation is published directly on this site without a chatbot intermediary.
      </p>
    </header>

    <div class="flex flex-wrap items-center gap-6 font-mono text-xs sm:text-sm">
      <a href="/work" class="text-accent-dark dark:text-accent hover:underline inline-flex items-center gap-1.5">
        <span>Selected Work</span>
        <span>→</span>
      </a>
      <a href="/lab" class="text-accent-dark dark:text-accent hover:underline inline-flex items-center gap-1.5">
        <span>The Lab</span>
        <span>→</span>
      </a>
      <a href="/notes" class="text-accent-dark dark:text-accent hover:underline inline-flex items-center gap-1.5">
        <span>Notes &amp; Writing</span>
        <span>→</span>
      </a>
      <a href="/" class="text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark">
        Homepage
      </a>
    </div>
  </main>
</BaseLayout>