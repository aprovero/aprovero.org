---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Level3SupportSpotlight from '@/components/Level3SupportSpotlight.astro';
---

<BaseLayout
  title="Field Engineering ToolHub (Level3Support) | Andres Provero"
  description="Interactive preview and launcher for Level3Support — 40+ offline-capable Solar PV, BESS, Grid, and SCADA engineering utilities built by Andres Provero."
>
  <main class="max-w-6xl mx-auto px-5 sm:px-10 py-12 sm:py-20 space-y-12">
    
    <header class="space-y-4 border-b-2 border-ink-light/85 dark:border-ink-dark/85 pb-8">
      <div class="flex items-center gap-2 font-mono text-xs text-accent-dark dark:text-accent tracking-wider uppercase font-semibold">
        <span class="inline-block w-2 h-2 rounded-full bg-signal"></span>
        <span>SYS-L3 // FIELD ENGINEERING TOOLHUB</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold uppercase tracking-tight text-ink-light dark:text-ink-dark">
        Don't Just Read About Field Engineering. Run the Tools.
      </h1>
      <p class="text-base sm:text-lg text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed max-w-3xl">
        Instead of a generic AI résumé chatbot, I maintain <strong>Level3Support</strong>—a live, 100% offline-capable engineering suite with 40+ specialized calculators, fault decoders, and workflows for utility-scale Solar PV, BESS, and medium-voltage commissioning.
      </p>
    </header>

    <Level3SupportSpotlight />

    <div class="pt-4 flex items-center justify-between font-mono text-xs sm:text-sm">
      <a href="/" class="text-ink-light-muted hover:text-accent-dark dark:text-ink-dark-muted dark:hover:text-accent inline-flex items-center gap-1.5">
        <span>←</span>
        <span>Back to homepage</span>
      </a>
      <a href="/work/level3support" class="text-accent-dark dark:text-accent hover:underline font-semibold inline-flex items-center gap-1.5">
        <span>Read full Level3Support case study</span>
        <span>→</span>
      </a>
    </div>

  </main>
</BaseLayout>