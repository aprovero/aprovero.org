---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { getCollection } from 'astro:content';

const allLab = await getCollection('lab');
const sortedLab = allLab.sort((a, b) => a.data.order - b.data.order);

const labWithRendered = await Promise.all(
  sortedLab.map(async (project) => {
    const { Content } = await project.render();
    return { ...project, Content };
  })
);
---

<BaseLayout
  title="The Lab | Andres Provero"
  description="Homelab infrastructure, hardware prototyping, automation, and electronics experiments by Andres Provero in Mexico City."
>
  <main class="max-w-6xl mx-auto px-6 sm:px-10 py-12 sm:py-20 space-y-16 sm:space-y-20">
    
    <!-- Header & Manifesto -->
    <header class="space-y-5 border-b border-border-light/80 dark:border-border-dark/80 pb-10">
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
        <span>SELF-HOSTED COMPUTE · HARDWARE · EXPERIMENTAL WORK</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink-light dark:text-ink-dark">
        The Lab
      </h1>

      <div class="pt-1">
        <StatusBadge />
      </div>

      <div class="space-y-4 text-ink-light-secondary dark:text-ink-dark-secondary text-[1.05rem] leading-[1.8] pt-2 max-w-3xl">
        <p class="font-medium text-ink-light dark:text-ink-dark">
          This site is served from infrastructure I operate myself.
        </p>
        <p>
          My homelab is where I experiment with servers, networking, self-hosting, monitoring, automation, electronics, software, AI, and things that were probably easier not to build.
        </p>
        <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted">
          Commercial clouds optimize for rapid delivery by hiding complexity behind managed abstractions. Running bare metal, routing isolated networks, and designing circuit protection forces you to confront the physical limits of hardware—thermal dissipation, electrical isolation, and the unyielding reality of failure modes.
        </p>
      </div>
    </header>

    <!-- Sanitized System Architecture Diagram (Technical character for /lab) -->
    <section class="space-y-5 max-w-4xl">
      <div class="flex items-baseline justify-between border-b border-border-light/80 dark:border-border-dark/80 pb-3">
        <h2 class="text-base sm:text-lg font-bold font-mono tracking-tight text-ink-light dark:text-ink-dark">
          [ ARCHITECTURE: SANITIZED TOPOLOGY ]
        </h2>
        <span class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
          Egress-Only Tunnel
        </span>
      </div>

      <div class="p-5 sm:p-6 rounded bg-surface-dark-card border border-border-dark font-mono text-xs sm:text-sm text-slate-300 overflow-x-auto leading-relaxed">
        <pre class="text-[#c9d1d9]"><code>+-------------------------------------------------------------+
|                     EXTERNAL TRAFFIC                        |
|   https://aprovero.org  --&gt;  Cloudflare Edge / CDN          |
|   - WAF rules &amp; DDoS mitigation                             |
|   - Automatic TLS certificate lifecycle                     |
+------------------------------+------------------------------+
                               |
                               | (Outbound-only Encrypted Tunnel)
                               v
+-------------------------------------------------------------+
|                HOMELAB INGRESS &amp; ISOLATION                  |
|   - Zero exposed inbound router ports                       |
|   - Reverse proxy container terminates ingress              |
+------------------------------+------------------------------+
                               |
                               | (Internal Isolated Docker Network)
                               v
+-------------------------------------------------------------+
|                PRODUCTION SERVICE WORKLOAD                  |
|   [ Container: aprovero.org ]                               |
|   - Alpine Linux (minimal read-only root)                   |
|   - Nginx static worker (unprivileged user)                 |
|   - Memory footprint: &lt; 15 MB                               |
+-------------------------------------------------------------+
                               |
                               | (Telemetry Scraping)
                               v
+-------------------------------------------------------------+
|                MONITORING &amp; RESILIENCE                      |
|   - Prometheus time-series metric collection                |
|   - Grafana telemetry dashboards (thermals, memory, UPS)    |
|   - ZFS storage pools with hourly encrypted off-site sync   |
+-------------------------------------------------------------+</code></pre>
      </div>

      <p class="text-xs font-mono text-ink-light-muted dark:text-ink-dark-muted">
        <span class="text-accent-dark dark:text-accent font-semibold">* Security Policy:</span> Sensitive hostnames, IP allocations, VLAN numbering, firewall rules, and authentication hashes are deliberately excluded.
      </p>
    </section>

    <!-- Lab Projects Deep-Dive -->
    <section class="space-y-12 max-w-4xl">
      <div class="border-b border-border-light/80 dark:border-border-dark/80 pb-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-light dark:text-ink-dark">
          Projects &amp; Experiments
        </h2>
        <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted mt-1 font-mono">
          Hardware prototyping, embedded electronics, and software tools built to solve specific problems.
        </p>
      </div>

      <div class="space-y-16">
        {
          labWithRendered.map((project) => (
            <article id={project.slug} class="scroll-mt-24 space-y-6 pt-6 border-t border-border-light/80 dark:border-border-dark/80 first:border-t-0 first:pt-0">
              <header class="space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted">
                  <span class="text-accent-dark dark:text-accent font-medium">[{project.data.category}]</span>
                  <span>STATUS: {project.data.status}</span>
                </div>

                <h3 class="text-2xl sm:text-3xl font-bold text-ink-light dark:text-ink-dark">
                  {project.data.title}
                </h3>

                <p class="text-[1.05rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed">
                  {project.data.summary}
                </p>

                <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
                  {project.data.technologies.map((tech) => (
                    <span class="bg-surface-light-muted dark:bg-surface-dark-muted px-2 py-0.5 rounded">
                      {tech}
                    </span>
                  ))}
                </div>
              </header>

              <div class="prose-editorial">
                <project.Content />
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Footer navigation -->
    <div class="pt-10 border-t border-border-light/80 dark:border-border-dark/80 flex items-center justify-between font-mono text-xs sm:text-sm">
      <a href="/" class="text-ink-light-muted hover:text-accent-dark dark:text-ink-dark-muted dark:hover:text-accent inline-flex items-center gap-1.5">
        <span>←</span>
        <span>Back to homepage</span>
      </a>
      <a href="#top" class="text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark inline-flex items-center gap-1.5">
        <span>Back to top</span>
        <span>↑</span>
      </a>
    </div>

  </main>
</BaseLayout>