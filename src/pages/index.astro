---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import PortraitDoodle from '@/components/PortraitDoodle.astro';
import { siteConfig } from '@/config/site';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const sortedWork = allWork.sort((a, b) => a.data.order - b.data.order);

const laPimienta = sortedWork.find((item) => item.slug === 'la-pimienta')!;
const losCuervos = sortedWork.find((item) => item.slug === 'los-cuervos')!;
const moonPalace = sortedWork.find((item) => item.slug === 'moon-palace')!;
const latnovvaTools = sortedWork.find((item) => item.slug === 'latnovva-digital-tools')!;
const level3Support = sortedWork.find((item) => item.slug === 'level3support')!;

const allNotes = await getCollection('notes');
const recentNotes = allNotes
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

const scaleMetrics = [
  { value: "2.1+ GW", label: "Operating solar fleet supported" },
  { value: "800+ MW", label: "Personally commissioned (SAT)" },
  { value: "60+ MWh", label: "Battery energy storage (BESS)" },
  { value: "15+ Years", label: "Field operations to executive" },
];

const coreDomains = [
  {
    index: "01",
    title: "Utility PV & BESS Architecture",
    meta: "Huawei Digital Power · Sept 2026–Present",
    logo: "/logos/huawei-digital-power.svg",
    logoAlt: "Huawei Digital Power",
    body: "Leading technical sales, pre-sales architecture, and solution design for utility-scale solar PV and battery energy storage—bridging power electronics and grid integration with commercial strategy across Mexico and LATAM.",
  },
  {
    index: "02",
    title: "Commissioning & Fleet Governance",
    meta: "Sungrow Power · LATNOVVA · Vector · SLB",
    logo: "/logos/sungrow.png",
    logoAlt: "Sungrow Power",
    body: "Progressed from hands-on substation commissioning (800+ MW SAT) to leading regional service across 2.1+ GW of solar and 60 MWh of BESS, establishing the LATAM Center of Expertise (CoE) for Tier-3 R&D escalations.",
  },
  {
    index: "03",
    title: "Operational Tooling & Systems",
    meta: "Level3Support · Self-Hosted Homelab",
    body: "Turning field bottlenecks into repeatable digital tools: creator of Level3Support (40+ offline-first engineering utilities) and operator of a 24/7 Linux, Docker, and n8n homelab built on repurposed hardware.",
  },
];

const labServices = [
  { name: "n8n", icon: "/icons/services/n8n.svg" },
  { name: "Immich", icon: "/icons/services/immich.svg" },
  { name: "Home Assistant", icon: "/icons/services/home-assistant.svg" },
  { name: "Portainer", icon: "/icons/services/portainer.svg" },
  { name: "Uptime Kuma", icon: "/icons/services/uptime-kuma.svg" },
  { name: "AdGuard", icon: "/icons/services/adguard-home.svg" },
  { name: "Nextcloud", icon: "/icons/services/nextcloud.svg" },
  { name: "Tailscale", icon: "/icons/services/tailscale.svg" },
];
---

<BaseLayout>
  <main class="max-w-6xl mx-auto px-6 sm:px-10 py-10 sm:py-14 space-y-20 sm:space-y-24">

    <!-- BLOCK 1: UNIFIED ARCHITECTURAL SPLIT HERO & DOMAIN DOSSIER -->
    <section class="space-y-4" aria-labelledby="hero-heading">
      <div class="border border-border-light dark:border-border-dark bg-border-light dark:bg-border-dark space-y-px">

        <!-- Top Hairline Status Strip -->
        <div class="bg-surface-light dark:bg-surface-dark px-6 sm:px-9 py-3.5 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
          <div class="flex items-center gap-2.5 text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
            <span class="inline-block w-2 h-2 rounded-full bg-accent-dark dark:bg-accent"></span>
            <span>ENERGY INFRASTRUCTURE · TECHNICAL OPERATIONS · MEXICO CITY</span>
          </div>

          <div class="flex items-center gap-3 text-ink-light-muted dark:text-ink-dark-muted">
            <span class="hidden sm:inline">CURRENT //</span>
            <span class="text-ink-light dark:text-ink-dark font-medium">Huawei Digital Power</span>
            <img
              src="/logos/huawei-digital-power.svg"
              alt="Huawei Digital Power"
              class="h-4 w-auto object-contain dark:brightness-110"
            />
          </div>
        </div>

        <!-- Main Asymmetric Architectural Split Hero Row -->
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_310px] gap-px bg-border-light dark:bg-border-dark">
          
          <!-- Left Cell: Primary Editorial Statement -->
          <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-10 lg:p-12 flex flex-col justify-between gap-8">
            <div class="space-y-6">
              <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted uppercase tracking-widest">
                00 // Executive Dossier
              </div>

              <h1
                id="hero-heading"
                class="font-display text-4xl sm:text-5xl lg:text-[3.85rem] font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-[1.03]"
              >
                {siteConfig.thesis}
              </h1>

              <p class="text-lg sm:text-[1.2rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.68] max-w-2xl font-normal">
                {siteConfig.intro}
              </p>

              <p class="text-base text-ink-light-muted dark:text-ink-dark-muted leading-[1.7] max-w-2xl">
                {siteConfig.secondaryIntro}
              </p>
            </div>

            <div class="pt-2 flex flex-wrap items-center gap-6 text-sm font-mono">
              <a
                href="/work"
                class="text-ink-light dark:text-ink-dark hover:text-accent-dark dark:hover:text-accent font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <span>All case studies &amp; career</span>
                <span class="text-accent-dark dark:text-accent">→</span>
              </a>
              <a
                href="/lab"
                class="text-ink-light dark:text-ink-dark hover:text-accent-dark dark:hover:text-accent font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <span>The lab</span>
                <span class="text-accent-dark dark:text-accent">→</span>
              </a>
              <a
                href={siteConfig.socials.linkedin.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark inline-flex items-center gap-1 transition-colors"
              >
                <span>LinkedIn</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <!-- Right Cell: Integrated Portrait & Spec Readout -->
          <div class="bg-surface-light-card/40 dark:bg-surface-dark-card/40 flex flex-col justify-between">
            <div class="p-6 sm:p-7 pb-4 flex justify-center lg:block">
              <div class="w-full max-w-[240px] lg:max-w-none">
                <PortraitDoodle />
              </div>
            </div>

            <div class="px-6 sm:px-7 pb-6 pt-2 space-y-2.5 font-mono text-xs">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-ink-light-muted dark:text-ink-dark-muted">DISCIPLINE</span>
                <span class="text-ink-light dark:text-ink-dark text-right">PV · BESS · Substations</span>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-ink-light-muted dark:text-ink-dark-muted">TRACK</span>
                <span class="text-ink-light dark:text-ink-dark text-right">Field SAT → CoE → Sales</span>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-ink-light-muted dark:text-ink-dark-muted">BASE</span>
                <span class="text-ink-light dark:text-ink-dark text-right">Mexico City (LATAM)</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Integrated 4-Cell Tabular Scale Strip -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-border-light dark:bg-border-dark">
          {scaleMetrics.map((m) => (
            <div class="bg-surface-light dark:bg-surface-dark px-6 py-5 sm:px-8 sm:py-6 space-y-1">
              <div class="font-display text-3xl sm:text-[2.15rem] font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-none">
                {m.value}
              </div>
              <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted pt-1">
                {m.label}
              </div>
            </div>
          ))}
        </div>

        <!-- Integrated 3-Column Core Operating Domains -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-border-light dark:bg-border-dark">
          {coreDomains.map((domain) => (
            <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-8 flex flex-col justify-between gap-6">
              <div class="space-y-3.5">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium">
                    {domain.index} // DOMAIN
                  </span>
                  {domain.logo && (
                    <img
                      src={domain.logo}
                      alt={domain.logoAlt}
                      class="h-5 w-auto max-w-[115px] object-contain dark:brightness-110"
                    />
                  )}
                </div>

                <h2 class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
                  {domain.title}
                </h2>

                <p class="text-[0.94rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
                  {domain.body}
                </p>
              </div>

              <div class="font-mono text-[0.74rem] text-ink-light-muted dark:text-ink-dark-muted">
                {domain.meta}
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Quiet Link to Full Career Track Record -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted px-1">
        <span>Spanning utility renewables, oil &amp; gas wireline (SLB, YPF), telecom, and control systems.</span>
        <a href="/work#career" class="text-accent-dark dark:text-accent hover:underline font-medium shrink-0">
          Full career history (2008–Present) →
        </a>
      </div>
    </section>

    <!-- BLOCK 2: SELECTED HIGHLIGHTS (ASYMMETRIC VISUAL & SCHEMATIC SHOWCASE) -->
    <section id="work" class="space-y-6" aria-labelledby="work-heading">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <div>
          <h2 id="work-heading" class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
            Selected Highlights
          </h2>
          <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted mt-1">
            Flagship utility generation plants, energy storage, and operational engineering software.
          </p>
        </div>
        <a
          href="/work"
          class="font-mono text-xs sm:text-sm text-accent-dark dark:text-accent hover:underline shrink-0"
        >
          View all {sortedWork.length} case studies &amp; career →
        </a>
      </div>

      <!-- Asymmetric Interlocking Showcase Frame -->
      <div class="border border-border-light dark:border-border-dark bg-border-light dark:bg-border-dark space-y-px">

        <!-- TIER 1: Full-Width Asymmetric Flagship Utility Plant + SLD Schematic (La Pimienta 358 MW PV) -->
        <article class="grid grid-cols-1 lg:grid-cols-[1.05fr_1.2fr] gap-px bg-border-light dark:bg-border-dark group">
          <!-- Left Primary Narrative Cell -->
          <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-9 lg:p-10 flex flex-col justify-between gap-6">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium tracking-wider uppercase">
                  01 // FLAGSHIP UTILITY PLANT · {laPimienta.data.systemType}
                </span>
                <span class="font-mono text-xs px-2.5 py-1 rounded bg-surface-light-card dark:bg-surface-dark-card border border-border-light dark:border-border-dark text-ink-light dark:text-ink-dark font-medium">
                  {laPimienta.data.capacity}
                </span>
              </div>

              <div class="space-y-1.5 pt-1">
                <h3 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-tight">
                  <a
                    href={`/work/${laPimienta.slug}`}
                    class="inline-flex items-center gap-2.5 hover:text-accent-dark dark:hover:text-accent transition-colors"
                  >
                    <span>{laPimienta.data.title}</span>
                    <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-lg font-mono">→</span>
                  </a>
                </h3>
                <p class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
                  {laPimienta.data.location} · {laPimienta.data.year} · {laPimienta.data.role}
                </p>
              </div>

              <p class="text-base sm:text-[1.02rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
                {laPimienta.data.summary}
              </p>
            </div>

            <div class="pt-2 flex items-center justify-between font-mono text-xs">
              <a
                href={`/work/${laPimienta.slug}`}
                class="text-accent-dark dark:text-accent font-medium hover:underline inline-flex items-center gap-1.5"
              >
                <span>Read flagship case study</span>
                <span>→</span>
              </a>
              <span class="text-ink-light-muted dark:text-ink-dark-muted hidden sm:inline">
                SAT &amp; Grid-Code Acceptance
              </span>
            </div>
          </div>

          <!-- Right Bespoke Single-Line Power Block Schematic (SVG) -->
          <div class="bg-surface-light-card/55 dark:bg-surface-dark-card/75 bg-technical-grid p-6 sm:p-8 flex flex-col justify-between gap-5">
            <div class="flex items-center justify-between font-mono text-[0.72rem] text-ink-light-muted dark:text-ink-dark-muted uppercase tracking-wider">
              <span>SINGLE-LINE TOPOLOGY // POWER BLOCK TO HV POI</span>
              <span class="text-accent-dark dark:text-accent font-medium">● 358 MW ENERGIZED</span>
            </div>

            <!-- Precision Vector Single-Line Diagram -->
            <div class="border border-border-light dark:border-border-dark bg-surface-light/90 dark:bg-surface-dark/90 p-4 sm:p-5">
              <svg viewBox="0 0 540 132" class="w-full h-auto text-ink-light dark:text-ink-dark" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Stage 1: 1500V DC Combiner / PV Field -->
                <rect x="6" y="16" width="106" height="74" rx="2" class="stroke-border-light dark:stroke-border-dark fill-surface-light-card dark:fill-surface-dark-card" stroke-width="1.2"/>
                <text x="15" y="33" fill="#E59838" class="font-mono" font-size="8.5" font-weight="600">01 // DC FIELD</text>
                <text x="15" y="50" fill="currentColor" class="font-mono" font-size="10" font-weight="600">1500 Vdc</text>
                <text x="15" y="65" fill="currentColor" fill-opacity="0.65" class="font-mono" font-size="7.5">R_iso Megger Check</text>
                <text x="15" y="78" fill="currentColor" fill-opacity="0.65" class="font-mono" font-size="7.5">Cold Walk-Down</text>

                <!-- DC Bus Line + Switch Symbol -->
                <line x1="112" y1="53" x2="148" y2="53" stroke="#E59838" stroke-width="1.75"/>
                <circle cx="130" cy="53" r="3" class="fill-surface-dark" stroke="#E59838" stroke-width="1.5"/>

                <!-- Stage 2: Central Inverter PCS Skid -->
                <rect x="148" y="16" width="122" height="74" rx="2" class="stroke-border-light dark:stroke-border-dark fill-surface-light-card dark:fill-surface-dark-card" stroke-width="1.2"/>
                <line x1="236" y1="24" x2="262" y2="46" stroke="currentColor" stroke-opacity="0.25" stroke-width="1"/>
                <text x="158" y="33" fill="#E59838" class="font-mono" font-size="8.5" font-weight="600">02 // CENTRAL PCS</text>
                <text x="158" y="50" fill="currentColor" class="font-mono" font-size="10" font-weight="600">DC / AC Skid</text>
                <text x="158" y="65" fill="currentColor" fill-opacity="0.65" class="font-mono" font-size="7.5">LVRT / HVRT Curve</text>
                <text x="158" y="78" fill="currentColor" fill-opacity="0.65" class="font-mono" font-size="7.5">P/Q Loop Tuning</text>

                <!-- Step-Up Transformer Symbol (Dual Intersecting Circles) -->
                <line x1="270" y1="53" x2="294" y2="53" stroke="#E59838" stroke-width="1.75"/>
                <circle cx="303" cy="53" r="9" stroke="#E59838" stroke-width="1.6" fill="none"/>
                <circle cx="315" cy="53" r="9" stroke="#E59838" stroke-width="1.6" fill="none"/>
                <text x="287" y="76" fill="#E59838" class="font-mono" font-size="7.5">0.8 / 34.5 kV</text>
                <line x1="324" y1="53" x2="348" y2="53" stroke="#E59838" stroke-width="1.75"/>

                <!-- Stage 3: MV Collector & HV Substation POI -->
                <rect x="348" y="16" width="184" height="74" rx="2" class="stroke-border-light dark:stroke-border-dark fill-surface-light-card dark:fill-surface-dark-card" stroke-width="1.2"/>
                <text x="358" y="33" fill="#E59838" class="font-mono" font-size="8.5" font-weight="600">03 // SUBSTATION POI (SAT)</text>
                <text x="358" y="50" fill="currentColor" class="font-mono" font-size="10.5" font-weight="600">34.5 kV / 230 kV Grid</text>
                <text x="358" y="65" fill="currentColor" fill-opacity="0.7" class="font-mono" font-size="7.5">● Relay &amp; Trip Interlock Ring-Out</text>
                <text x="358" y="78" fill="#E59838" class="font-mono" font-size="7.5">● Commercial Operations Handover</text>

                <!-- Bottom Telemetry / Protection Feedback Bus -->
                <path d="M 59 90 L 59 114 L 440 114 L 440 90" stroke="currentColor" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3 3" fill="none"/>
                <rect x="175" y="104" width="190" height="18" rx="2" class="fill-surface-light dark:fill-surface-dark stroke-border-light dark:stroke-border-dark" stroke-width="1"/>
                <text x="187" y="116" fill="currentColor" fill-opacity="0.75" class="font-mono" font-size="7.5">SCADA · E-STOP LOOP · ANTI-CONDENSATION</text>
              </svg>
            </div>

            <!-- Bottom Key Metrics Strip -->
            <div class="grid grid-cols-3 gap-2 font-mono text-[0.72rem]">
              <div class="px-3 py-2 bg-surface-light dark:bg-surface-dark border border-border-light/80 dark:border-border-dark/80">
                <span class="text-ink-light-muted dark:text-ink-dark-muted block">CAPACITY</span>
                <span class="text-ink-light dark:text-ink-dark font-semibold">358 MW Utility PV</span>
              </div>
              <div class="px-3 py-2 bg-surface-light dark:bg-surface-dark border border-border-light/80 dark:border-border-dark/80">
                <span class="text-ink-light-muted dark:text-ink-dark-muted block">SCOPE</span>
                <span class="text-ink-light dark:text-ink-dark font-semibold">Cold → Hot SAT</span>
              </div>
              <div class="px-3 py-2 bg-surface-light dark:bg-surface-dark border border-border-light/80 dark:border-border-dark/80">
                <span class="text-ink-light-muted dark:text-ink-dark-muted block">INTERCONNECTION</span>
                <span class="text-ink-light dark:text-ink-dark font-semibold">National HV Grid</span>
              </div>
            </div>
          </div>
        </article>

        <!-- TIER 2: 50/50 Utility Solar & Battery Storage Pair (Los Cuervos + Moon Palace with SVG Schematics) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border-light dark:bg-border-dark">
          <ProjectRow
            title={losCuervos.data.title}
            subtitle={losCuervos.data.subtitle}
            location={losCuervos.data.location}
            capacity={losCuervos.data.capacity}
            systemType={losCuervos.data.systemType}
            year={losCuervos.data.year}
            role={losCuervos.data.role}
            summary={losCuervos.data.summary}
            slug={losCuervos.slug}
          />
          <ProjectRow
            title={moonPalace.data.title}
            subtitle={moonPalace.data.subtitle}
            location={moonPalace.data.location}
            capacity={moonPalace.data.capacity}
            systemType={moonPalace.data.systemType}
            year={moonPalace.data.year}
            role={moonPalace.data.role}
            summary={moonPalace.data.summary}
            slug={moonPalace.slug}
          />
        </div>

        <!-- TIER 3A: Full-Width Asymmetric Field Operations Platform Showcase with Real App Visuals (LATNOVVA) -->
        <article class="grid grid-cols-1 lg:grid-cols-[1.05fr_1.2fr] gap-px bg-border-light dark:bg-border-dark group">
          <!-- Left Narrative Cell -->
          <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-9 lg:p-10 flex flex-col justify-between gap-6">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium tracking-wider uppercase">
                  04 // FIELD OPERATIONS SOFTWARE · NEXT.JS + POSTGIS
                </span>
                <span class="font-mono text-xs px-2.5 py-1 rounded bg-surface-light-card dark:bg-surface-dark-card border border-border-light dark:border-border-dark text-ink-light dark:text-ink-dark font-medium">
                  {latnovvaTools.data.capacity}
                </span>
              </div>

              <div class="space-y-1.5 pt-1">
                <h3 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-tight">
                  <a
                    href={`/work/${latnovvaTools.slug}`}
                    class="inline-flex items-center gap-2.5 hover:text-accent-dark dark:hover:text-accent transition-colors"
                  >
                    <span>{latnovvaTools.data.title}</span>
                    <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-lg font-mono">→</span>
                  </a>
                </h3>
                <p class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
                  {latnovvaTools.data.location} · {latnovvaTools.data.year} · {latnovvaTools.data.role}
                </p>
              </div>

              <p class="text-base sm:text-[1.02rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
                {latnovvaTools.data.summary} Cut weekly payroll reconciliation from 14 hours to under 30 minutes across 14 Mexican states with two-tier GPS geofence auditing.
              </p>
            </div>

            <div class="pt-2 flex flex-wrap items-center gap-6 font-mono text-xs">
              <a
                href={`/work/${latnovvaTools.slug}`}
                class="text-accent-dark dark:text-accent font-medium hover:underline inline-flex items-center gap-1.5"
              >
                <span>Read system case study</span>
                <span>→</span>
              </a>
              <a
                href="https://latnovvamx.onrender.com/commercial-portal"
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-light-secondary dark:text-ink-dark-secondary hover:text-ink-light dark:hover:text-ink-dark transition-colors inline-flex items-center gap-1"
              >
                <span>Explore live portal</span>
                <span>↗</span>
              </a>
