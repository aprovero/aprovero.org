---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { siteConfig } from '@/config/site';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const sortedWork = allWork.sort((a, b) => a.data.order - b.data.order);

const laPimienta = sortedWork.find((item) => item.slug === 'la-pimienta')!;
const losCuervos = sortedWork.find((item) => item.slug === 'los-cuervos')!;
const moonPalace = sortedWork.find((item) => item.slug === 'moon-palace')!;
const level3Support = sortedWork.find((item) => item.slug === 'level3support')!;

const allNotes = await getCollection('notes');
const recentNotes = allNotes
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

const scaleMetrics = [
  { value: "2.1+ GW", label: "Operating solar fleet supported" },
  { value: "800+ MW", label: "Personally commissioned (SAT)" },
  { value: "60+ MWh", label: "Battery energy storage (BESS)" },
  { value: "15+ Years", label: "Field operations to executive" },
];

const coreDomains = [
  {
    index: "01",
    title: "Utility PV & BESS Architecture",
    meta: "Huawei Digital Power · Sept 2026–Present",
    logo: "/logos/huawei-digital-power.svg",
    logoAlt: "Huawei Digital Power",
    body: "Leading technical sales, pre-sales architecture, and solution design for utility-scale solar PV and battery energy storage—bridging power electronics and grid integration with commercial strategy across Mexico and LATAM.",
  },
  {
    index: "02",
    title: "Commissioning & Fleet Governance",
    meta: "Sungrow Power · LATNOVVA · Vector · SLB",
    logo: "/logos/sungrow.png",
    logoAlt: "Sungrow Power",
    body: "Progressed from hands-on substation commissioning (800+ MW SAT) to leading regional service across 2.1+ GW of solar and 60 MWh of BESS, establishing the LATAM Center of Expertise (CoE) for Tier-3 R&D escalations.",
  },
  {
    index: "03",
    title: "Operational Tooling & Systems",
    meta: "Level3Support · Self-Hosted Homelab",
    body: "Turning field bottlenecks into repeatable digital tools: creator of Level3Support (40+ offline-first engineering utilities) and operator of a 24/7 Linux, Docker, and n8n homelab built on repurposed hardware.",
  },
];

const laPimientaScopes = [
  {
    code: "01",
    label: "Pre-Energization & Cold Walk-Down",
    detail: "Mechanical/electrical inspection, insulation resistance verification, and control circuit ring-out prior to HV/MV energization.",
  },
  {
    code: "02",
    label: "Grid-Code & Protection Parameterization",
    detail: "Central inverter protection settings, voltage/frequency ride-through compliance, and active/reactive power loop tuning.",
  },
  {
    code: "03",
    label: "Site Acceptance Testing (SAT)",
    detail: "Full functional verification, emergency trip interlocks, SCADA integration checks, and commercial handover to asset operations.",
  },
];

const level3Modules = [
  { code: "01", name: "Fault Code Interpreter", domain: "16/32-Bit Hex Inverter Diagnostics" },
  { code: "02", name: "UMCG Telemetry Analyzer", domain: "Thermal & Electrical Curve Plotting" },
  { code: "03", name: "Cable & Voltage Drop", domain: "MV/LV Ampacity & Thermal Derating" },
  { code: "04", name: "Arc Flash Boundary", domain: "NFPA 70E Incident Energy (cal/cm²)" },
  { code: "05", name: "Fuse Thermal Derating", domain: "High-Speed Semiconductor Protection" },
  { code: "06", name: "BESS Health Analyzer", domain: "Cell Spread & SOH Degradation" },
];
---

<BaseLayout>
  <main class="max-w-6xl mx-auto px-6 sm:px-10 py-10 sm:py-14 space-y-20 sm:space-y-24">

    <!-- BLOCK 1: UNIFIED ARCHITECTURAL SPLIT HERO & DOMAIN DOSSIER -->
    <section class="space-y-4" aria-labelledby="hero-heading">
      <div class="border border-border-light dark:border-border-dark bg-border-light dark:bg-border-dark space-y-px">

        <!-- Top Hairline Status Strip -->
        <div class="bg-surface-light dark:bg-surface-dark px-6 sm:px-9 py-3.5 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
          <div class="flex items-center gap-2.5 text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
            <span class="inline-block w-2 h-2 rounded-full bg-accent-dark dark:bg-accent"></span>
            <span>ENERGY INFRASTRUCTURE · TECHNICAL OPERATIONS · MEXICO CITY</span>
          </div>

          <div class="flex items-center gap-3 text-ink-light-muted dark:text-ink-dark-muted">
            <span class="hidden sm:inline">CURRENT //</span>
            <span class="text-ink-light dark:text-ink-dark font-medium">Huawei Digital Power</span>
            <img
              src="/logos/huawei-digital-power.svg"
              alt="Huawei Digital Power"
              class="h-4 w-auto object-contain dark:brightness-110"
            />
          </div>
        </div>

        <!-- Main Asymmetric Architectural Split Hero Row -->
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_310px] gap-px bg-border-light dark:bg-border-dark">
          
          <!-- Left Cell: Primary Editorial Statement -->
          <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-10 lg:p-12 flex flex-col justify-between gap-8">
            <div class="space-y-6">
              <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted uppercase tracking-widest">
                00 // Executive Dossier
              </div>

              <h1
                id="hero-heading"
                class="font-display text-4xl sm:text-5xl lg:text-[3.85rem] font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-[1.03]"
              >
                {siteConfig.thesis}
              </h1>

              <p class="text-lg sm:text-[1.2rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.68] max-w-2xl font-normal">
                {siteConfig.intro}
              </p>

              <p class="text-base text-ink-light-muted dark:text-ink-dark-muted leading-[1.7] max-w-2xl">
                {siteConfig.secondaryIntro}
              </p>
            </div>

            <div class="pt-2 flex flex-wrap items-center gap-6 text-sm font-mono">
              <a
                href="/work"
                class="text-ink-light dark:text-ink-dark hover:text-accent-dark dark:hover:text-accent font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <span>All case studies &amp; career</span>
                <span class="text-accent-dark dark:text-accent">→</span>
              </a>
              <a
                href="/lab"
                class="text-ink-light dark:text-ink-dark hover:text-accent-dark dark:hover:text-accent font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <span>The lab</span>
                <span class="text-accent-dark dark:text-accent">→</span>
              </a>
              <a
                href={siteConfig.socials.linkedin.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark inline-flex items-center gap-1 transition-colors"
              >
                <span>LinkedIn</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <!-- Right Cell: Integrated Portrait & Spec Readout -->
          <div class="bg-surface-light-card/40 dark:bg-surface-dark-card/40 flex flex-col justify-between">
            <div class="p-6 sm:p-7 pb-4 flex justify-center lg:block">
              <img
                src="/brand/portrait.jpg"
                alt="Andres Provero"
                width="290"
                height="441"
                class="w-full max-w-[240px] lg:max-w-none h-auto border border-border-light dark:border-border-dark object-cover"
              />
            </div>

            <div class="px-6 sm:px-7 pb-6 pt-2 space-y-2.5 font-mono text-xs">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-ink-light-muted dark:text-ink-dark-muted">DISCIPLINE</span>
                <span class="text-ink-light dark:text-ink-dark text-right">PV · BESS · Substations</span>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-ink-light-muted dark:text-ink-dark-muted">TRACK</span>
                <span class="text-ink-light dark:text-ink-dark text-right">Field SAT → CoE → Sales</span>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-ink-light-muted dark:text-ink-dark-muted">BASE</span>
                <span class="text-ink-light dark:text-ink-dark text-right">Mexico City (LATAM)</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Integrated 4-Cell Tabular Scale Strip -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-border-light dark:bg-border-dark">
          {scaleMetrics.map((m) => (
            <div class="bg-surface-light dark:bg-surface-dark px-6 py-5 sm:px-8 sm:py-6 space-y-1">
              <div class="font-display text-3xl sm:text-[2.15rem] font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-none">
                {m.value}
              </div>
              <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted pt-1">
                {m.label}
              </div>
            </div>
          ))}
        </div>

        <!-- Integrated 3-Column Core Operating Domains -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-border-light dark:bg-border-dark">
          {coreDomains.map((domain) => (
            <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-8 flex flex-col justify-between gap-6">
              <div class="space-y-3.5">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium">
                    {domain.index} // DOMAIN
                  </span>
                  {domain.logo && (
                    <img
                      src={domain.logo}
                      alt={domain.logoAlt}
                      class="h-5 w-auto max-w-[115px] object-contain dark:brightness-110"
                    />
                  )}
                </div>

                <h2 class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
                  {domain.title}
                </h2>

                <p class="text-[0.94rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
                  {domain.body}
                </p>
              </div>

              <div class="font-mono text-[0.74rem] text-ink-light-muted dark:text-ink-dark-muted">
                {domain.meta}
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Quiet Link to Full Career Track Record -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted px-1">
        <span>Spanning utility renewables, oil &amp; gas wireline (SLB, YPF), telecom, and control systems.</span>
        <a href="/work#career" class="text-accent-dark dark:text-accent hover:underline font-medium shrink-0">
          Full career history (2008–Present) →
        </a>
      </div>
    </section>

    <!-- BLOCK 2: SELECTED HIGHLIGHTS (ASYMMETRIC ARCHITECTURAL SHOWCASE) -->
    <section id="work" class="space-y-6" aria-labelledby="work-heading">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <div>
          <h2 id="work-heading" class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
            Selected Highlights
          </h2>
          <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted mt-1">
            Flagship utility generation plants, energy storage, and operational engineering software.
          </p>
        </div>
        <a
          href="/work"
          class="font-mono text-xs sm:text-sm text-accent-dark dark:text-accent hover:underline shrink-0"
        >
          View all {sortedWork.length} case studies &amp; career →
        </a>
      </div>

      <!-- Asymmetric 3-Tier Interlocking Grid -->
      <div class="border border-border-light dark:border-border-dark bg-border-light dark:bg-border-dark space-y-px">

        <!-- TIER 1: Full-Width Asymmetric Flagship Utility Plant (La Pimienta 358 MW PV) -->
        <article class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-px bg-border-light dark:bg-border-dark group">
          <!-- Left Primary Narrative Cell -->
          <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-9 lg:p-10 flex flex-col justify-between gap-6">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium tracking-wider uppercase">
                  FLAGSHIP UTILITY PLANT · {laPimienta.data.systemType}
                </span>
                <span class="font-mono text-xs px-2.5 py-1 rounded bg-surface-light-card dark:bg-surface-dark-card border border-border-light dark:border-border-dark text-ink-light dark:text-ink-dark font-medium">
                  {laPimienta.data.capacity}
                </span>
              </div>

              <div class="space-y-1.5 pt-1">
                <h3 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-tight">
                  <a
                    href={`/work/${laPimienta.slug}`}
                    class="inline-flex items-center gap-2.5 hover:text-accent-dark dark:hover:text-accent transition-colors"
                  >
                    <span>{laPimienta.data.title}</span>
                    <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-lg font-mono">→</span>
                  </a>
                </h3>
                <p class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
                  {laPimienta.data.location} · {laPimienta.data.year} · {laPimienta.data.role}
                </p>
              </div>

              <p class="text-base sm:text-[1.04rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
                {laPimienta.data.summary}
              </p>
            </div>

            <div class="pt-2 flex items-center justify-between font-mono text-xs">
              <a
                href={`/work/${laPimienta.slug}`}
                class="text-accent-dark dark:text-accent font-medium hover:underline inline-flex items-center gap-1.5"
              >
                <span>Read flagship case study</span>
                <span>→</span>
              </a>
              <span class="text-ink-light-muted dark:text-ink-dark-muted hidden sm:inline">
                Central Inverter Stations · National Grid Interconnection
              </span>
            </div>
          </div>

          <!-- Right Engineering Execution Breakdown Cell -->
          <div class="bg-surface-light-card/45 dark:bg-surface-dark-card/45 p-7 sm:p-9 flex flex-col justify-between gap-5">
            <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted uppercase tracking-wider">
              Field Execution &amp; Acceptance Scope
            </div>

            <div class="space-y-4">
              {laPimientaScopes.map((s) => (
                <div class="space-y-1">
                  <div class="flex items-baseline gap-2.5">
                    <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium">{s.code}</span>
                    <span class="font-display text-base sm:text-lg font-semibold text-ink-light dark:text-ink-dark">
                      {s.label}
                    </span>
                  </div>
                  <p class="text-xs sm:text-[0.84rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed pl-6">
                    {s.detail}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </article>

        <!-- TIER 2: 50/50 Utility Solar & Battery Storage Pair (Los Cuervos + Moon Palace) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border-light dark:bg-border-dark">
          <ProjectRow
            title={losCuervos.data.title}
            subtitle={losCuervos.data.subtitle}
            location={losCuervos.data.location}
            capacity={losCuervos.data.capacity}
            systemType={losCuervos.data.systemType}
            year={losCuervos.data.year}
            role={losCuervos.data.role}
            summary={losCuervos.data.summary}
            slug={losCuervos.slug}
          />
          <ProjectRow
            title={moonPalace.data.title}
            subtitle={moonPalace.data.subtitle}
            location={moonPalace.data.location}
            capacity={moonPalace.data.capacity}
            systemType={moonPalace.data.systemType}
            year={moonPalace.data.year}
            role={moonPalace.data.role}
            summary={moonPalace.data.summary}
            slug={moonPalace.slug}
          />
        </div>

        <!-- TIER 3: Full-Width Asymmetric Operational Tooling Showcase (Level3Support) -->
        <article class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-px bg-border-light dark:bg-border-dark group">
          <!-- Left Narrative & Action Cell -->
          <div class="bg-surface-light dark:bg-surface-dark p-7 sm:p-9 lg:p-10 flex flex-col justify-between gap-6">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium tracking-wider uppercase">
                  OPERATIONAL ENGINEERING SUITE · OFFLINE-FIRST
                </span>
                <span class="font-mono text-xs px-2.5 py-1 rounded bg-surface-light-card dark:bg-surface-dark-card border border-border-light dark:border-border-dark text-ink-light dark:text-ink-dark font-medium">
                  {level3Support.data.capacity}
                </span>
              </div>

              <div class="space-y-1.5 pt-1">
                <h3 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-tight">
                  <a
                    href={`/work/${level3Support.slug}`}
                    class="inline-flex items-center gap-2.5 hover:text-accent-dark dark:hover:text-accent transition-colors"
                  >
                    <span>{level3Support.data.title}</span>
                    <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-lg font-mono">→</span>
                  </a>
                </h3>
                <p class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
                  {level3Support.data.location} · {level3Support.data.year} · {level3Support.data.role}
                </p>
              </div>

              <p class="text-base sm:text-[1.04rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
                {level3Support.data.summary}
              </p>
            </div>

            <div class="pt-2 flex flex-wrap items-center gap-6 font-mono text-xs">
              <a
                href={`/work/${level3Support.slug}`}
                class="text-accent-dark dark:text-accent font-medium hover:underline inline-flex items-center gap-1.5"
              >
                <span>Read architecture &amp; origin story</span>
                <span>→</span>
              </a>
              <a
                href="https://level3supporttools.onrender.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-light-secondary dark:text-ink-dark-secondary hover:text-ink-light dark:hover:text-ink-dark transition-colors inline-flex items-center gap-1"
              >
                <span>Launch app</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <!-- Right 2x3 Representative Modules Matrix -->
          <div class="bg-surface-light-card/45 dark:bg-surface-dark-card/45 p-7 sm:p-9 flex flex-col justify-between gap-4">
            <div class="flex items-center justify-between font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted uppercase tracking-wider">
              <span>Representative Diagnostic &amp; Sizing Modules</span>
              <span>PWA / Local-First</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {level3Modules.map((mod) => (
                <div class="p-3 bg-surface-light dark:bg-surface-dark border border-border-light/80 dark:border-border-dark/80 space-y-0.5">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-[0.7rem] text-accent-dark dark:text-accent">{mod.code}</span>
                    <span class="font-display text-sm sm:text-base font-semibold text-ink-light dark:text-ink-dark">
                      {mod.name}
                    </span>
                  </div>
                  <div class="font-mono text-[0.72rem] text-ink-light-muted dark:text-ink-dark-muted pl-5">
                    {mod.domain}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- BLOCK 3: SIDE-BY-SIDE BENCH & FIELD LOG (THE LAB + NOTES IN 50/50 SPLIT) -->
    <section aria-label="The Lab and Field Notes">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-px bg-border-light dark:bg-border-dark border border-border-light dark:border-border-dark">
        
        <!-- Left Cell (50%): The Lab -->
        <div id="lab" class="bg-surface-light dark:bg-surface-dark p-7 sm:p-9 flex flex-col justify-between gap-8">
          <div class="space-y-5">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
                The Lab
              </h2>
              <a href="/lab" class="font-mono text-xs text-accent-dark dark:text-accent hover:underline">
                Architecture &amp; stack →
              </a>
            </div>

            <div class="space-y-3">
              <p class="font-medium text-ink-light dark:text-ink-dark text-base sm:text-lg">
                Learning systems by building and operating them.
              </p>
              <p class="text-[0.95rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
                An unused 2013 ASUS VivoPC brought out of retirement to run a 24/7 headless Ubuntu Server and Docker environment—powering self-hosted n8n automations, smart budgeting pipelines, and household utilities behind Cloudflare Zero Trust tunnels.
              </p>
            </div>

            <!-- Hardware Visual + Stack Summary -->
            <div class="grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-4 pt-1 items-center">
              <a href="/lab" class="block overflow-hidden border border-border-light dark:border-border-dark">
                <img
                  src="/lab/asus-vivopc.jpg"
                  alt="2013 ASUS VivoPC Homelab Node"
                  class="w-full h-24 object-cover hover:scale-105 transition-transform"
                />
              </a>
              <div class="grid grid-cols-2 gap-3 font-mono text-xs">
                <div class="p-3 border border-border-light dark:border-border-dark bg-surface-light-card/40 dark:bg-surface-dark-card/40">
                  <div class="text-ink-light dark:text-ink-dark font-medium">Host &amp; Runtime</div>
                  <div class="text-ink-light-muted dark:text-ink-dark-muted mt-1">Ubuntu · Docker · CasaOS</div>
                </div>
                <div class="p-3 border border-border-light dark:border-border-dark bg-surface-light-card/40 dark:bg-surface-dark-card/40">
                  <div class="text-ink-light dark:text-ink-dark font-medium">Active Workloads</div>
                  <div class="text-ink-light-muted dark:text-ink-dark-muted mt-1">n8n · Immich · Home Assistant</div>
                </div>
              </div>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
            <StatusBadge />
            <a href="/services" class="text-ink-light-secondary dark:text-ink-dark-secondary hover:text-accent-dark dark:hover:text-accent transition-colors">
              Services Console →
            </a>
          </div>
        </div>

        <!-- Right Cell (50%): Field Notes & Writing -->
        <div id="notes" class="bg-surface-light dark:bg-surface-dark p-7 sm:p-9 flex flex-col justify-between gap-8">
          <div class="space-y-5">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
                Notes &amp; Writing
              </h2>
              <a href="/notes" class="font-mono text-xs text-accent-dark dark:text-accent hover:underline">
                All notes →
              </a>
            </div>

            <div class="divide-y divide-border-light/60 dark:divide-border-dark/60">
              {recentNotes.map((note) => {
                const formattedDate = new Date(note.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                });
                return (
                  <article class="py-3.5 first:pt-0 last:pb-0 group">
                    <a href={`/notes/${note.slug}`} class="flex items-baseline justify-between gap-4">
                      <h3 class="font-display text-lg font-semibold text-ink-light dark:text-ink-dark group-hover:text-accent-dark dark:group-hover:text-accent transition-colors">
                        {note.data.title}
                      </h3>
                      <span class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted shrink-0">
                        {formattedDate}
                      </span>
                    </a>
                    <p class="text-xs sm:text-sm text-ink-light-secondary dark:text-ink-dark-secondary line-clamp-1 mt-1">
                      {note.data.summary}
                    </p>
                  </article>
                );
              })}
            </div>
          </div>

          <div class="pt-2 flex items-center justify-between font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
            <span>Field observations &amp; systems notes</span>
            <a href="/rss.xml" class="hover:text-accent-dark dark:hover:text-accent transition-colors">
              RSS Feed ↗
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- BLOCK 4: COMPACT ARCHITECTURAL CONTACT BAR -->
    <section id="contact" aria-labelledby="contact-heading">
      <div class="border border-border-light dark:border-border-dark p-7 sm:p-9 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-1">
          <h2 id="contact-heading" class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
            Direct Contact
          </h2>
          <p class="text-sm sm:text-base text-ink-light-secondary dark:text-ink-dark-secondary">
            Available for conversations around utility-scale energy infrastructure, technical operations, and engineering systems.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3.5 text-xs sm:text-sm font-mono shrink-0">
          <a
            href={siteConfig.socials.email.href}
            class="px-4 py-2.5 rounded bg-accent text-surface-dark font-medium hover:bg-accent-hover transition-colors inline-flex items-center gap-2"
          >
            <span>{siteConfig.email}</span>
            <span>✉</span>
          </a>
          <a
            href={siteConfig.socials.linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded border border-border-light dark:border-border-dark hover:border-accent/40 text-ink-light dark:text-ink-dark transition-colors inline-flex items-center gap-1.5"
          >
            <span>LinkedIn</span>
            <span>↗</span>
          </a>
          <a
            href={siteConfig.socials.github.href}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded border border-border-light dark:border-border-dark hover:border-accent/40 text-ink-light dark:text-ink-dark transition-colors inline-flex items-center gap-1.5"
          >
            <span>GitHub</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>