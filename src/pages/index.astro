---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CareerTimeline from '@/components/CareerTimeline.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import NoteRow from '@/components/NoteRow.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { siteConfig } from '@/config/site';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const sortedWork = allWork.sort((a, b) => a.data.order - b.data.order);
const featuredWork = sortedWork.filter((item) => item.data.featured);

const allNotes = await getCollection('notes');
const sortedNotes = allNotes.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const indexMetrics = [
  {
    value: "2.1+ GW",
    label: "Operating solar fleet supported",
  },
  {
    value: "800+ MW",
    label: "Personally commissioned (SAT)",
  },
  {
    value: "60+ MWh",
    label: "Battery energy storage (BESS)",
  },
  {
    value: "15+ Years",
    label: "Field operations to executive",
  },
];
---

<BaseLayout>
  <main class="max-w-6xl mx-auto px-6 sm:px-10 py-12 sm:py-20 space-y-28 sm:space-y-36">

    <!-- HERO SECTION -->
    <section class="space-y-12 pt-4 sm:pt-6" aria-labelledby="hero-heading">
      <!-- Eyebrow Metadata -->
      <div class="flex items-center gap-2.5 font-mono text-xs sm:text-sm text-accent-dark dark:text-accent tracking-wider uppercase font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-accent-dark dark:bg-accent"></span>
        <span>ENERGY INFRASTRUCTURE · TECHNICAL OPERATIONS · MEXICO CITY</span>
      </div>

      <!-- Main Statement & Portrait -->
      <div class="grid grid-cols-1 md:grid-cols-[1fr_280px] lg:grid-cols-[1fr_300px] gap-10 lg:gap-16 items-start">
        <div class="space-y-6">
          <h1
            id="hero-heading"
            class="font-display text-4xl sm:text-5xl lg:text-[3.6rem] font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-[1.08]"
          >
            {siteConfig.thesis}
          </h1>

          <p class="text-lg sm:text-xl text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed max-w-2xl font-normal">
            {siteConfig.intro}
          </p>

          <p class="text-base sm:text-lg text-ink-light-muted dark:text-ink-dark-muted leading-relaxed max-w-2xl">
            {siteConfig.secondaryIntro}
          </p>

          <!-- Restrained Text Links -->
          <div class="pt-3 flex flex-wrap items-center gap-7 text-sm sm:text-base font-mono">
            <a
              href="#work"
              class="text-ink-light dark:text-ink-dark hover:text-accent-dark dark:hover:text-accent font-medium inline-flex items-center gap-1.5 transition-colors"
            >
              <span>Selected work</span>
              <span class="text-accent-dark dark:text-accent">↓</span>
            </a>
            <a
              href="#story"
              class="text-ink-light dark:text-ink-dark hover:text-accent-dark dark:hover:text-accent font-medium inline-flex items-center gap-1.5 transition-colors"
            >
              <span>Career</span>
              <span class="text-accent-dark dark:text-accent">↓</span>
            </a>
            <a
              href="#lab"
              class="text-ink-light dark:text-ink-dark hover:text-accent-dark dark:hover:text-accent font-medium inline-flex items-center gap-1.5 transition-colors"
            >
              <span>The lab</span>
              <span class="text-accent-dark dark:text-accent">↓</span>
            </a>
            <a
              href={siteConfig.socials.linkedin.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark inline-flex items-center gap-1 transition-colors"
            >
              <span>LinkedIn</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Portrait Frame -->
        <div class="order-first md:order-last w-full max-w-[260px] md:max-w-[300px] mx-auto md:mx-0">
          <img
            src="/brand/portrait.jpg"
            alt="Andres Provero"
            width="300"
            height="456"
            class="w-full h-auto rounded border border-border-light dark:border-border-dark shadow-sm object-cover"
          />
        </div>
      </div>

      <!-- Architectural Hairline Index Strip -->
      <div class="border-y border-border-light dark:border-border-dark py-6 grid grid-cols-2 lg:grid-cols-4 gap-y-6 gap-x-8 lg:gap-x-0 lg:divide-x divide-border-light dark:divide-border-dark">
        {indexMetrics.map((m, idx) => (
          <div class:list={["space-y-1", idx > 0 && "lg:pl-8"]}>
            <div class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
              {m.value}
            </div>
            <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
              {m.label}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SELECTED WORK SECTION -->
    <section id="work" class="space-y-4" aria-labelledby="work-heading">
      <div class="border-b border-border-light dark:border-border-dark pb-5 flex items-baseline justify-between gap-4">
        <div>
          <h2 id="work-heading" class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
            Selected Work
          </h2>
          <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted mt-1">
            Real infrastructure and engineering tools delivered across solar PV, battery storage, and field operations.
          </p>
        </div>
        <a
          href="/work"
          class="font-mono text-xs sm:text-sm text-accent-dark dark:text-accent hover:underline shrink-0"
        >
          View all →
        </a>
      </div>

      <div class="divide-y divide-border-light dark:divide-border-dark border-b border-border-light dark:border-border-dark">
        {
          featuredWork.map((project) => (
            <ProjectRow
              title={project.data.title}
              subtitle={project.data.subtitle}
              location={project.data.location}
              capacity={project.data.capacity}
              systemType={project.data.systemType}
              year={project.data.year}
              role={project.data.role}
              summary={project.data.summary}
              slug={project.slug}
            />
          ))
        }
      </div>

      <!-- Quiet Confidentiality Footnote -->
      <p class="pt-3 text-xs text-ink-light-muted dark:text-ink-dark-muted font-mono leading-relaxed max-w-3xl">
        <strong class="text-ink-light-secondary dark:text-ink-dark-secondary font-medium">Confidentiality note:</strong> Specific customer telemetry, proprietary equipment settings, internal manufacturer investigations, and commercial dispatch parameters are omitted from public documentation.
      </p>
    </section>

    <!-- CAREER STORY SECTION -->
    <section id="story" class="space-y-4" aria-labelledby="story-heading">
      <div class="border-b border-border-light dark:border-border-dark pb-5 flex items-baseline justify-between">
        <h2 id="story-heading" class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
          Career Story
        </h2>
        <span class="font-mono text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted">
          2008 — Present
        </span>
      </div>

      <CareerTimeline />
    </section>

    <!-- THE LAB SECTION -->
    <section id="lab" class="space-y-8" aria-labelledby="lab-heading">
      <div class="border-b border-border-light dark:border-border-dark pb-5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <div>
          <h2 id="lab-heading" class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
            The Lab
          </h2>
          <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted mt-1">
            Self-hosted infrastructure, hardware reuse, workflow automation, and household systems.
          </p>
        </div>
        <a
          href="/lab"
          class="font-mono text-xs sm:text-sm text-accent-dark dark:text-accent hover:underline shrink-0"
        >
          Explore lab →
        </a>
      </div>

      <!-- Architectural Hairline Rows for Lab -->
      <div class="divide-y divide-border-light dark:divide-border-dark border-b border-border-light dark:border-border-dark">
        
        <!-- Row 1: Homelab Infrastructure -->
        <article class="py-8 grid grid-cols-1 md:grid-cols-[210px_1fr] lg:grid-cols-[240px_1fr] gap-4 md:gap-10 lg:gap-12 items-start">
          <div class="font-mono text-xs space-y-1.5 pt-1 md:border-r md:border-border-light/80 dark:md:border-border-dark/80 md:pr-6">
            <div class="text-ink-light dark:text-ink-dark font-semibold text-sm">
              Homelab Platform
            </div>
            <div class="text-accent-dark dark:text-accent font-medium">
              24/7 Headless Host
            </div>
            <div class="text-ink-light-muted dark:text-ink-dark-muted pt-1">
              Ubuntu · Docker · n8n
            </div>
          </div>

          <div class="space-y-3">
            <h3 class="font-display text-2xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
              <a href="/lab" class="hover:text-accent-dark dark:hover:text-accent transition-colors inline-flex items-center gap-2">
                <span>Reusing Hardware for Real Services</span>
                <span class="text-accent-dark dark:text-accent text-base font-mono">→</span>
              </a>
            </h3>
            <p class="text-[1.01rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.78] max-w-3xl">
              What started as an unused 2013 ASUS VivoPC brought out of retirement to experiment with self-hosted n8n and automation has expanded into a 24/7 learning environment for Docker, Linux, and household services—while public web hosting stays cleanly separated on Cloudflare Pages.
            </p>
            <div class="pt-1 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
              <StatusBadge />
              <a href="/lab" class="text-accent-dark dark:text-accent hover:underline font-medium">
                Explore lab &amp; service stack →
              </a>
            </div>
          </div>
        </article>

        <!-- Row 2: Local AI & Automation -->
        <article class="py-8 grid grid-cols-1 md:grid-cols-[210px_1fr] lg:grid-cols-[240px_1fr] gap-4 md:gap-10 lg:gap-12 items-start">
          <div class="font-mono text-xs space-y-1.5 pt-1 md:border-r md:border-border-light/80 dark:md:border-border-dark/80 md:pr-6">
            <div class="text-ink-light dark:text-ink-dark font-semibold text-sm">
              Automation &amp; AI
            </div>
            <div class="text-accent-dark dark:text-accent font-medium">
              Workflows &amp; Agents
            </div>
            <div class="text-ink-light-muted dark:text-ink-dark-muted pt-1">
              n8n · Python · Local Tools
            </div>
          </div>

          <div class="space-y-2.5">
            <h3 class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
              <a href="/lab" class="hover:text-accent-dark dark:hover:text-accent transition-colors inline-flex items-center gap-2">
                <span>Self-Hosted Workflows &amp; Technical Grounding</span>
                <span class="text-accent-dark dark:text-accent text-base font-mono">→</span>
              </a>
            </h3>
            <p class="text-[1rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.78] max-w-3xl">
              Practical experiments with automated expense ingestion, task routing, and technical knowledge retrieval over multi-hundred-page equipment manuals and inverter register maps.
            </p>
          </div>
        </article>

      </div>
    </section>

    <!-- NOTES SECTION -->
    <section id="notes" class="space-y-4" aria-labelledby="notes-heading">
      <div class="border-b border-border-light dark:border-border-dark pb-5 flex items-baseline justify-between">
        <div>
          <h2 id="notes-heading" class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
            Notes &amp; Writing
          </h2>
          <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted mt-1">
            Field observations, homelab architecture, and engineering principles.
          </p>
        </div>
        <a
          href="/notes"
          class="font-mono text-xs sm:text-sm text-accent-dark dark:text-accent hover:underline shrink-0"
        >
          All notes →
        </a>
      </div>

      <div class="divide-y divide-border-light dark:divide-border-dark border-b border-border-light dark:border-border-dark">
        {
          sortedNotes.map((note) => (
            <NoteRow
              title={note.data.title}
              date={note.data.date}
              summary={note.data.summary}
              tags={note.data.tags}
              draft={note.data.draft}
              readTime={note.data.readTime}
              slug={note.slug}
            />
          ))
        }
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="space-y-8 pt-2" aria-labelledby="contact-heading">
      <div class="border-b border-border-light dark:border-border-dark pb-5">
        <h2 id="contact-heading" class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink-light dark:text-ink-dark">
          Contact
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-start justify-between">
        <p class="text-ink-light-secondary dark:text-ink-dark-secondary text-[1.05rem] leading-[1.8] max-w-2xl">
          If you want to talk about engineering, energy infrastructure, technical operations, technology, or something interesting enough to build, feel free to reach out.
        </p>

        <div class="flex flex-wrap items-center gap-4 text-sm font-mono shrink-0">
          <a
            href={siteConfig.socials.email.href}
            class="px-5 py-2.5 rounded bg-accent text-surface-dark font-medium hover:bg-accent-hover transition-colors inline-flex items-center justify-center gap-2"
          >
            <span>{siteConfig.email}</span>
            <span>✉</span>
          </a>

          <a
            href={siteConfig.socials.linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded border border-border-light dark:border-border-dark bg-surface-light-card dark:bg-surface-dark-card hover:border-accent/40 text-ink-light dark:text-ink-dark transition-colors inline-flex items-center justify-center gap-2"
          >
            <span>LinkedIn</span>
            <span>↗</span>
          </a>

          <a
            href={siteConfig.socials.github.href}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded border border-border-light dark:border-border-dark bg-surface-light-card dark:bg-surface-dark-card hover:border-accent/40 text-ink-light dark:text-ink-dark transition-colors inline-flex items-center justify-center gap-2"
          >
            <span>GitHub</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>