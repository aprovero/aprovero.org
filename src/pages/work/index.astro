---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const sortedWork = allWork.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Infrastructure Dossiers & Selected Work | Andres Provero"
  description="Engineering case studies across utility-scale Solar PV, BESS, power conversion systems, field operations, and Level3Support in Latin America."
>
  <main class="max-w-6xl mx-auto px-5 sm:px-10 py-12 sm:py-20 space-y-14">
    
    <!-- Page Header -->
    <header class="space-y-5 border-b-2 border-ink-light/85 dark:border-ink-dark/85 pb-10">
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm text-accent-dark dark:text-accent tracking-wider uppercase font-semibold">
        <span class="w-2 h-2 rounded-full bg-signal"></span>
        <span>BUS-02 // ENGINEERING CASE STUDIES &amp; PLANT DOSSIERS</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-bold uppercase tracking-tight text-ink-light dark:text-ink-dark">
        Selected Engineering Work
      </h1>
      <p class="text-lg sm:text-xl text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed max-w-3xl">
        Utility-scale energy infrastructure projects and operational platforms where I led or executed commissioning, inverter parameterization, site acceptance testing (SAT), and field engineering tools.
      </p>

      <!-- Confidentiality Banner -->
      <div class="p-4 sm:p-5 rounded-lg border border-border-light dark:border-border-dark bg-surface-light-card dark:bg-surface-dark-card text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted font-mono leading-relaxed space-y-1.5 max-w-3xl">
        <div class="text-ink-light dark:text-ink-dark font-semibold flex items-center gap-2">
          <span class="text-accent-dark dark:text-accent">[NDA]</span>
          <span>Confidentiality &amp; Integrity Protocol</span>
        </div>
        <p>
          These dossiers document engineering methodology, physical site constraints, and field execution. Specific OEM parameter files, internal escalations, single-line protection thresholds, and commercial agreements are intentionally omitted.
        </p>
      </div>
    </header>

    <!-- Case Studies Dossier Stack -->
    <div class="space-y-5">
      {
        sortedWork.map((project) => (
          <ProjectRow
            title={project.data.title}
            subtitle={project.data.subtitle}
            location={project.data.location}
            capacity={project.data.capacity}
            systemType={project.data.systemType}
            year={project.data.year}
            role={project.data.role}
            summary={project.data.summary}
            slug={project.slug}
          />
        ))
      }
    </div>

    <!-- Back to top / home link -->
    <div class="pt-6 font-mono text-xs sm:text-sm">
      <a href="/" class="text-ink-light-muted hover:text-accent-dark dark:text-ink-dark-muted dark:hover:text-accent inline-flex items-center gap-1.5">
        <span>←</span>
        <span>Back to homepage</span>
      </a>
    </div>

  </main>
</BaseLayout>