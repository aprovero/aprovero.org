---
import { siteConfig } from '@/config/site';

const { homelabMetadata } = siteConfig;
---

<div class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 py-1 font-mono text-[0.8rem] text-ink-light-muted dark:text-ink-dark-muted">
  <span class="text-ink-light dark:text-ink-dark font-medium">{homelabMetadata.domain}</span>
  <span class="opacity-30">·</span>
  <span>{homelabMetadata.hosting}</span>
  <span class="opacity-30">·</span>
  <span>{homelabMetadata.location}</span>
</div>