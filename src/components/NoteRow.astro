---
interface Props {
  title: string;
  date: string;
  summary: string;
  tags: string[];
  draft?: boolean;
  readTime: string;
  slug: string;
}

const { title, date, summary, tags, draft = false, readTime, slug } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<article class="group py-5 border-b border-border-light dark:border-border-dark transition-colors">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
    <div class="flex items-center gap-2">
      {draft && (
        <span class="font-mono text-[0.68rem] font-semibold px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
          DRAFT
        </span>
      )}
      <h3 class="text-base sm:text-lg font-semibold text-ink-light dark:text-ink-dark">
        <a
          href={`/notes/${slug}`}
          class="hover:text-accent-dark dark:hover:text-accent transition-colors inline-flex items-center gap-1"
        >
          <span>{title}</span>
          <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-xs">→</span>
        </a>
      </h3>
    </div>

    <div class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted shrink-0 flex items-center gap-2">
      <span>{formattedDate}</span>
      <span>·</span>
      <span>{readTime}</span>
    </div>
  </div>

  <p class="text-sm text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed mb-2.5 max-w-3xl">
    {summary}
  </p>

  <div class="flex flex-wrap gap-2 text-[0.72rem] font-mono text-ink-light-muted dark:text-ink-dark-muted">
    {tags.map((tag) => (
      <span>#{tag}</span>
    ))}
  </div>
</article>