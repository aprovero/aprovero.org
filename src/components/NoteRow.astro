---
interface Props {
  title: string;
  date: string;
  summary: string;
  tags: string[];
  draft?: boolean;
  readTime: string;
  slug: string;
}

const { title, date, summary, tags, draft = false, readTime, slug } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<article class="group py-7 sm:py-8 border-b border-border-light/80 dark:border-border-dark/80 transition-colors">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
    <div class="flex items-center gap-2.5">
      {draft && (
        <span class="font-mono text-[0.72rem] text-amber-600 dark:text-amber-400 font-medium">
          [DRAFT]
        </span>
      )}
      <h3 class="text-lg sm:text-xl font-semibold text-ink-light dark:text-ink-dark">
        <a
          href={`/notes/${slug}`}
          class="hover:text-accent-dark dark:hover:text-accent transition-colors inline-flex items-center gap-1.5"
        >
          <span>{title}</span>
          <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-xs">→</span>
        </a>
      </h3>
    </div>

    <div class="font-mono text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted shrink-0 flex items-center gap-2">
      <span>{formattedDate}</span>
      <span class="opacity-30">·</span>
      <span>{readTime}</span>
    </div>
  </div>

  <p class="text-[1.02rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.8] my-3 max-w-3xl">
    {summary}
  </p>

  <div class="flex flex-wrap gap-2 text-xs font-mono text-ink-light-muted dark:text-ink-dark-muted">
    {tags.map((tag) => (
      <span>#{tag}</span>
    ))}
  </div>
</article>