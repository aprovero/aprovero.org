  <!-- Entry 3: Sungrow Power (2020–2025) -->
  <article class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-3 md:gap-10 items-start">
    <div class="font-mono text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted space-y-1">
