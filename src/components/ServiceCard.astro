---
import type { ServerService } from '@/config/services';

interface Props {
  service: ServerService;
}

const { service } = Astro.props;
---

<article
  class="service-card group relative flex flex-col justify-between p-6 sm:p-7 rounded-xl border border-border-light dark:border-border-dark bg-surface-light-card dark:bg-surface-dark-card hover:border-accent/50 dark:hover:border-accent/40 shadow-sm hover:shadow-md transition-all duration-200"
  data-category={service.category}
  data-name={service.name.toLowerCase()}
  data-tags={service.tags.join(' ').toLowerCase()}
  data-service-id={service.id}
  data-default-url={service.defaultUrl}
>
  <div>
    <!-- Top Row: Icon, Service Meta & Status + Hover-only Pencil -->
    <div class="flex items-start justify-between gap-3 mb-4">
      <div class="flex items-center gap-3.5">
        <!-- Official Service Icon Badge -->
        <div
          class="w-12 h-12 rounded-lg flex items-center justify-center border border-border-light/80 dark:border-border-dark/80 bg-surface-light-muted/80 dark:bg-surface-dark-muted/80 shrink-0 group-hover:scale-105 transition-transform p-2.5"
          style={`border-top-color: ${service.accentColor}; border-top-width: 2px;`}
        >
          <img
            src={service.iconUrl}
            alt={`${service.name} logo`}
            class="w-full h-full object-contain"
            width="28"
            height="28"
            loading="lazy"
          />
        </div>

        <div>
          <h3 class="text-lg font-bold tracking-tight text-ink-light dark:text-ink-dark group-hover:text-accent-dark dark:group-hover:text-accent transition-colors">
            {service.name}
          </h3>
          <span class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
            {service.role}
          </span>
        </div>
      </div>

      <!-- Top Right: Status Badge & Hover-only Pencil Button -->
      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Status Badge -->
        <div class="service-status-badge flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[0.7rem] font-mono font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="status-text">{service.status}</span>
        </div>

        <!-- Edit Pencil Icon (Only visible on hover) -->
        <button
          type="button"
          class="edit-url-btn p-1.5 rounded-md opacity-0 group-hover:opacity-100 hover:bg-surface-light-muted dark:hover:bg-surface-dark-muted text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark transition-all duration-150"
          data-service-id={service.id}
          data-service-name={service.name}
          title="Customize URL"
          aria-label={`Customize URL for ${service.name}`}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Description -->
    <p class="text-[0.92rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-relaxed mb-4">
      {service.description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-5">
      {service.tags.map((tag) => (
        <span class="px-2 py-0.5 rounded text-[0.72rem] font-mono bg-surface-light-muted dark:bg-surface-dark-muted text-ink-light-muted dark:text-ink-dark-muted border border-border-light/60 dark:border-border-dark/60">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Bottom Launch Section -->
  <div class="pt-4 border-t border-border-light/70 dark:border-border-dark/70">
    <a
      href={service.defaultUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="service-launch-link w-full py-2.5 px-4 rounded-lg bg-surface-light-muted dark:bg-surface-dark-muted hover:bg-accent hover:text-surface-dark dark:hover:bg-accent dark:hover:text-surface-dark text-ink-light dark:text-ink-dark font-mono text-xs sm:text-sm font-medium transition-colors flex items-center justify-center gap-2 border border-border-light dark:border-border-dark hover:border-transparent group/btn"
    >
      <span>Open {service.name}</span>
      <span class="text-accent-dark dark:text-accent group-hover/btn:text-surface-dark transition-colors">↗</span>
    </a>
  </div>
</article>
