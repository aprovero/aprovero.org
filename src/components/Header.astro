---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '@/config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="w-full border-b border-border-light dark:border-border-dark backdrop-blur-md sticky top-0 z-40 bg-surface-light/95 dark:bg-surface-dark/95 transition-colors">
  <div class="max-w-6xl mx-auto px-5 sm:px-10 h-16 sm:h-20 flex items-center justify-between gap-3">
    <!-- Brand Identity: Vector APROVERO Wordmark with High-Voltage Amber Dot + Telemetry Tag -->
    <a
      href="/"
      class="group inline-flex items-center gap-3 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded py-1 shrink-0"
      aria-label="Andres Provero — Home"
    >
      <div class="relative inline-flex items-baseline font-sans font-semibold tracking-[-0.03em] text-2xl sm:text-[1.75rem] text-ink-light dark:text-ink-dark leading-none select-none">
        <span class="relative inline-block">
          a
          <span
            class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-accent-dark dark:bg-accent group-hover:scale-110 transition-transform"
            aria-hidden="true"
          ></span>
        </span><span>provero</span>
      </div>
      <span class="hidden lg:inline-flex items-center gap-1.5 pl-3 border-l border-border-light dark:border-border-dark font-mono text-[0.68rem] uppercase tracking-widest text-ink-light-muted dark:text-ink-dark-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-signal"></span>
        <span>SYS · PV / BESS</span>
      </span>
    </a>

    <!-- Primary Navigation & ToolHub Launcher -->
    <nav class="flex items-center gap-1.5 sm:gap-5 lg:gap-7" aria-label="Primary Navigation">
      {
        siteConfig.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "px-1.5 sm:px-0 py-1 font-display uppercase tracking-wider font-semibold transition-colors text-xs sm:text-[0.92rem]",
                active
                  ? "text-accent-dark dark:text-accent"
                  : "text-ink-light-secondary hover:text-ink-light dark:text-ink-dark-secondary dark:hover:text-ink-dark",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }

      <div class="flex items-center gap-1.5 sm:gap-2.5 pl-2 sm:pl-4 border-l border-border-light dark:border-border-dark ml-0.5 sm:ml-1">
        <!-- Direct L3 ToolHub Launch Button -->
        <a
          href="https://level3supporttools.onrender.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded border border-accent-dark/40 dark:border-accent/40 bg-accent/10 hover:bg-accent hover:text-surface-dark dark:hover:bg-accent dark:hover:text-surface-dark text-accent-dark dark:text-accent font-mono text-[0.7rem] sm:text-xs font-semibold tracking-tight transition-all group/l3"
          title="Launch Level3Support Field Engineering ToolHub (40+ Offline Tools)"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-signal group-hover/l3:bg-surface-dark"></span>
          <span class="hidden sm:inline">L3 ToolHub</span>
          <span class="sm:hidden">L3</span>
          <span class="text-[0.68rem] opacity-80">↗</span>
        </a>

        <!-- Services Portal Link -->
        <a
          href="/services"
          class:list={[
            "relative inline-flex items-center justify-center w-8 h-8 rounded transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent",
            isActive('/services')
              ? "text-accent-dark dark:text-accent bg-accent/15 border border-accent/30"
              : "text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark hover:bg-surface-light-muted dark:hover:bg-surface-dark-muted",
          ]}
          aria-label="Services Console"
          title="Homelab Services Console"
          aria-current={isActive('/services') ? "page" : undefined}
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect>
            <rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect>
            <line x1="6" x2="6.01" y1="6" y2="6"></line>
            <line x1="6" x2="6.01" y1="18" y2="18"></line>
          </svg>
        </a>

        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>