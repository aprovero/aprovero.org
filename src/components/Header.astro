---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '@/config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="w-full border-b border-border-light/80 dark:border-border-dark/80 backdrop-blur-md sticky top-0 z-40 bg-surface-light/95 dark:bg-surface-dark/95 transition-colors">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 h-20 flex items-center justify-between">
    <!-- Brand identity: APROVERO Logo (Increased presence ~30%) -->
    <a
      href="/"
      class="group inline-flex items-center gap-2 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded py-1"
      aria-label="Andres Provero — Home"
    >
      <img
        src="/brand/logo-transparent-light.png"
        alt="APROVERO"
        width="168"
        height="48"
        class="h-7 sm:h-[2.1rem] w-auto block dark:hidden transition-opacity group-hover:opacity-85"
      />
      <img
        src="/brand/logo-transparent-dark.png"
        alt="APROVERO"
        width="168"
        height="48"
        class="h-7 sm:h-[2.1rem] w-auto hidden dark:block transition-opacity group-hover:opacity-85"
      />
    </a>

    <!-- Primary Navigation -->
    <nav class="flex items-center gap-2 sm:gap-7" aria-label="Primary Navigation">
      {
        siteConfig.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "px-2 sm:px-0 py-1 font-medium transition-colors text-[0.92rem] sm:text-[0.96rem]",
                active
                  ? "text-ink-light dark:text-ink-dark"
                  : "text-ink-light-muted hover:text-ink-light dark:text-ink-dark-muted dark:hover:text-ink-dark",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }

      <div class="pl-2 border-l border-border-light dark:border-border-dark ml-1 sm:ml-2">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>