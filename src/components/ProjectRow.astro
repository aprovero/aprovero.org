---
interface Props {
  title: string;
  subtitle: string;
  location: string;
  capacity: string;
  systemType: string;
  year: string;
  role: string;
  summary: string;
  slug: string;
}

const { title, subtitle, location, capacity, systemType, year, role, summary, slug } = Astro.props;
const isLevel3 = slug === 'level3support';
---

<article class="group py-8 sm:py-10 grid grid-cols-1 md:grid-cols-[210px_1fr] lg:grid-cols-[240px_1fr] gap-4 md:gap-10 lg:gap-12 items-start transition-colors">
  <!-- Left Column: Tabular Architectural Spec Block -->
  <div class="font-mono text-xs space-y-1.5 pt-1 md:border-r md:border-border-light/80 dark:md:border-border-dark/80 md:pr-6">
    <div class="text-ink-light dark:text-ink-dark font-semibold text-sm tracking-tight">
      {capacity}
    </div>
    <div class="text-accent-dark dark:text-accent font-medium">
      {systemType}
    </div>
    <div class="text-ink-light-muted dark:text-ink-dark-muted pt-1">
      {location} · {year}
    </div>
  </div>

  <!-- Right Column: Narrative & Action Row -->
  <div class="space-y-3">
    <div>
      <h3 class="font-display text-2xl sm:text-[1.65rem] font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-snug">
        <a
          href={`/work/${slug}`}
          class="inline-flex items-center gap-2 hover:text-accent-dark dark:hover:text-accent transition-colors"
        >
          <span>{title}</span>
          <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-base font-mono">→</span>
        </a>
      </h3>
      <p class="text-sm text-ink-light-muted dark:text-ink-dark-muted mt-0.5">
        {subtitle}
      </p>
    </div>

    <p class="text-[1.01rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.78] max-w-3xl">
      {summary}
    </p>

    <div class="pt-2 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
      <div class="text-ink-light-muted dark:text-ink-dark-muted">
        <span class="text-ink-light dark:text-ink-dark font-medium">Role:</span> {role}
      </div>

      <div class="flex items-center gap-5">
        {isLevel3 && (
          <a
            href="https://level3supporttools.onrender.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-light-secondary dark:text-ink-dark-secondary hover:text-accent-dark dark:hover:text-accent transition-colors inline-flex items-center gap-1"
          >
            <span>Launch live app</span>
            <span>↗</span>
          </a>
        )}
        <a
          href={`/work/${slug}`}
          class="text-accent-dark dark:text-accent font-medium hover:underline inline-flex items-center gap-1"
        >
          <span>Read case study</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</article>