---
interface Props {
  title: string;
  subtitle: string;
  location: string;
  capacity: string;
  systemType: string;
  year: string;
  role: string;
  summary: string;
  slug: string;
}

const { title, subtitle, location, capacity, systemType, year, role, summary, slug } = Astro.props;
const isLevel3 = slug === 'level3support';
---

<article class="group bg-surface-light dark:bg-surface-dark hover:bg-surface-light-card/70 dark:hover:bg-surface-dark-card/70 p-7 sm:p-9 flex flex-col justify-between gap-7 transition-colors">
  <div class="space-y-4">
    <!-- Top Architectural Spec Row -->
    <div class="flex items-center justify-between gap-4">
      <span class="font-mono text-xs text-accent-dark dark:text-accent font-medium tracking-wider uppercase">
        {systemType}
      </span>
      <span class="font-mono text-xs px-2.5 py-1 rounded bg-surface-light-card dark:bg-surface-dark-card border border-border-light dark:border-border-dark text-ink-light dark:text-ink-dark font-medium shrink-0">
        {capacity}
      </span>
    </div>

    <!-- Title & Location Meta -->
    <div class="space-y-1.5 pt-1">
      <h3 class="font-display text-2xl sm:text-[1.75rem] font-semibold tracking-tight text-ink-light dark:text-ink-dark leading-tight">
        <a
          href={`/work/${slug}`}
          class="inline-flex items-center gap-2 hover:text-accent-dark dark:hover:text-accent transition-colors"
        >
          <span>{title}</span>
          <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-base font-mono">→</span>
        </a>
      </h3>

      <p class="font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted">
        {location} · {year} · {role}
      </p>
    </div>

    <!-- Summary -->
    <p class="text-[0.96rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.72]">
      {summary}
    </p>
  </div>

  <!-- Bottom Action Links -->
  <div class="pt-2 flex items-center justify-between gap-4 text-xs font-mono">
    <a
      href={`/work/${slug}`}
      class="text-accent-dark dark:text-accent font-medium hover:underline inline-flex items-center gap-1.5"
    >
      <span>Read case study</span>
      <span>→</span>
    </a>

    {isLevel3 && (
      <a
        href="https://level3supporttools.onrender.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink-light-muted dark:text-ink-dark-muted hover:text-ink-light dark:hover:text-ink-dark transition-colors inline-flex items-center gap-1"
      >
        <span>Launch app</span>
        <span>↗</span>
      </a>
    )}
  </div>
</article>