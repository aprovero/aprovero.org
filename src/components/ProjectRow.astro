---
interface Props {
  title: string;
  subtitle: string;
  location: string;
  capacity: string;
  systemType: string;
  year: string;
  role: string;
  summary: string;
  slug: string;
}

const { title, subtitle, location, capacity, systemType, year, role, summary, slug } = Astro.props;
---

<article class="group py-8 sm:py-10 border-b border-border-light/80 dark:border-border-dark/80 transition-colors">
  <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 mb-3">
    <div>
      <h3 class="text-xl sm:text-2xl font-bold text-ink-light dark:text-ink-dark tracking-tight">
        <a
          href={`/work/${slug}`}
          class="inline-flex items-center gap-2 hover:text-accent-dark dark:hover:text-accent transition-colors"
        >
          <span>{title}</span>
          <span class="text-accent-dark dark:text-accent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-base">→</span>
        </a>
      </h3>
      <p class="text-sm sm:text-base text-ink-light-muted dark:text-ink-dark-muted mt-1">
        {subtitle}
      </p>
    </div>

    <!-- Editorial Publication Metadata Line (No UI pill boxes) -->
    <div class="font-mono text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted shrink-0 pt-1">
      <span class="text-ink-light dark:text-ink-dark font-medium">{capacity}</span>
      <span class="opacity-30 mx-1.5">·</span>
      <span>{location}</span>
      <span class="opacity-30 mx-1.5">·</span>
      <span>{systemType}</span>
      <span class="opacity-30 mx-1.5">·</span>
      <span>{year}</span>
    </div>
  </div>

  <p class="text-[1.03rem] text-ink-light-secondary dark:text-ink-dark-secondary leading-[1.8] my-4 max-w-3xl">
    {summary}
  </p>

  <div class="flex items-center justify-between pt-1 text-xs sm:text-sm font-mono">
    <div class="text-ink-light-muted dark:text-ink-dark-muted">
      <span class="text-ink-light dark:text-ink-dark font-medium">Role:</span> {role}
    </div>
    <a
      href={`/work/${slug}`}
      class="text-accent-dark dark:text-accent font-medium hover:underline inline-flex items-center gap-1"
    >
      <span>Read case study</span>
      <span>→</span>
    </a>
  </div>
</article>