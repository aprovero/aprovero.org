---
// PortraitDoodle.astro — Interactive Light Trace
// When hovered (or tapped), a glowing dash of light traces the exact outline of Andres's face,
// accompanied by subtle architectural corner crosshairs and warm ambient specular lighting.
---

<div
  class="relative group/portrait cursor-pointer select-none overflow-hidden border border-border-light dark:border-border-dark bg-surface-dark-card transition-colors duration-300"
  id="portrait-interactive"
  role="button"
  tabindex="0"
  aria-label="Portrait of Andres Provero (hover to trace outline)"
>
  <!-- Base Professional Portrait -->
  <img
    src="/brand/portrait.jpg"
    alt="Andres Provero"
    width="290"
    height="441"
    class="w-full h-auto object-cover block transition-all duration-500 group-hover/portrait:scale-[1.015] group-hover/portrait:contrast-[1.03]"
  />

  <!-- Subtle Ambient Glow that warms up on hover -->
  <div
    class="absolute inset-0 pointer-events-none opacity-0 group-hover/portrait:opacity-100 transition-opacity duration-500 bg-radial-vignette mix-blend-screen"
    style="background: radial-gradient(circle at 54% 42%, rgba(229, 152, 56, 0.15) 0%, transparent 68%);"
  ></div>

  <!-- SVG Light Trace Overlay -->
  <svg
    viewBox="0 0 674 1024"
    class="absolute inset-0 w-full h-full pointer-events-none opacity-0 group-hover/portrait:opacity-100 transition-opacity duration-300 ease-out z-10"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Intense glowing filter for light beam -->
      <filter id="light-dash-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3.5" result="blur1" />
        <feGaussianBlur stdDeviation="9" result="blur2" />
        <feMerge>
          <feMergeNode in="blur2" />
          <feMergeNode in="blur1" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Soft bloom filter for ambient halo -->
      <filter id="soft-bloom" x="-25%" y="-25%" width="150%" height="150%">
        <feGaussianBlur stdDeviation="16" />
      </filter>

      <!-- Gradient for the light beam head and tail -->
      <linearGradient id="beam-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FFE8B3" />
        <stop offset="50%" stop-color="#E59838" />
        <stop offset="100%" stop-color="#B8651B" />
      </linearGradient>
    </defs>

    <!-- 1. FAINT BLUEPRINT CONTOUR (Subtle reference hairline visible under the light) -->
    <path
      d="M 355 118 C 435 125 500 170 535 245 C 555 290 562 340 556 400 C 568 450 568 495 558 550 C 545 615 515 700 475 765 C 440 815 410 835 385 838 C 335 835 285 805 240 755 C 195 690 160 610 148 545 C 125 500 100 450 105 390 C 112 340 145 280 178 225 C 220 160 280 120 355 118 Z"
      stroke="#E59838"
      stroke-width="1"
      stroke-opacity="0.22"
      stroke-dasharray="4 4"
    />

    <!-- 2. WIDE SOFT BLOOM HALO OF THE DASH -->
    <path
      class="light-dash-trace"
      d="M 355 118 C 435 125 500 170 535 245 C 555 290 562 340 556 400 C 568 450 568 495 558 550 C 545 615 515 700 475 765 C 440 815 410 835 385 838 C 335 835 285 805 240 755 C 195 690 160 610 148 545 C 125 500 100 450 105 390 C 112 340 145 280 178 225 C 220 160 280 120 355 118 Z"
      stroke="#E59838"
      stroke-width="14"
      stroke-linecap="round"
      filter="url(#soft-bloom)"
      opacity="0.6"
    />

    <!-- 3. GLOWING AMBER TRAIL -->
    <path
      class="light-dash-trace"
      d="M 355 118 C 435 125 500 170 535 245 C 555 290 562 340 556 400 C 568 450 568 495 558 550 C 545 615 515 700 475 765 C 440 815 410 835 385 838 C 335 835 285 805 240 755 C 195 690 160 610 148 545 C 125 500 100 450 105 390 C 112 340 145 280 178 225 C 220 160 280 120 355 118 Z"
      stroke="#E59838"
      stroke-width="4.5"
      stroke-linecap="round"
      filter="url(#light-dash-glow)"
    />

    <!-- 4. WHITE-HOT INTENSE CORE LIGHT DASH -->
    <path
      class="light-dash-trace"
      d="M 355 118 C 435 125 500 170 535 245 C 555 290 562 340 556 400 C 568 450 568 495 558 550 C 545 615 515 700 475 765 C 440 815 410 835 385 838 C 335 835 285 805 240 755 C 195 690 160 610 148 545 C 125 500 100 450 105 390 C 112 340 145 280 178 225 C 220 160 280 120 355 118 Z"
      stroke="#FFFBEB"
      stroke-width="2"
      stroke-linecap="round"
    />
  </svg>

  <!-- High-Tech Architectural Corner Crosshairs -->
  <div class="absolute top-2 left-2 text-ink-light-muted/40 dark:text-ink-dark-muted/40 group-hover/portrait:text-accent font-mono text-[9px] transition-colors select-none pointer-events-none">
    +
  </div>
  <div class="absolute top-2 right-2 text-ink-light-muted/40 dark:text-ink-dark-muted/40 group-hover/portrait:text-accent font-mono text-[9px] transition-colors select-none pointer-events-none">
    +
  </div>
  <div class="absolute bottom-2 left-2 text-ink-light-muted/40 dark:text-ink-dark-muted/40 group-hover/portrait:text-accent font-mono text-[9px] transition-colors select-none pointer-events-none">
    +
  </div>
  <div class="absolute bottom-2 right-2 flex items-center gap-1.5 font-mono text-[9px] text-ink-light-muted/50 dark:text-ink-dark-muted/50 group-hover/portrait:text-accent transition-colors select-none pointer-events-none pr-0.5">
    <span>+</span>
  </div>
</div>

<style>
  /* Continuous looping dash of light tracing the perimeter of the face (~1850px total length) */
  .light-dash-trace {
    stroke-dasharray: 240 1610;
    animation: traceLight 2.2s linear infinite;
  }

  @keyframes traceLight {
    0% {
      stroke-dashoffset: 1850;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Pause animation when not hovered to save CPU cycles */
  .group\/portrait:not(:hover):not(.is-active) .light-dash-trace {
    animation-play-state: paused;
  }
</style>

<script>
  // Mobile touch toggle support
  const el = document.getElementById('portrait-interactive');
  if (el) {
    el.addEventListener('click', () => {
      const svg = el.querySelector('svg');
      if (svg) {
        svg.classList.toggle('!opacity-100');
        el.classList.toggle('is-active');
      }
    });

    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const svg = el.querySelector('svg');
        if (svg) {
          svg.classList.toggle('!opacity-100');
          el.classList.toggle('is-active');
        }
      }
    });
  }
</script>
