---
interface Props {
  caption?: string;
  subcaption?: string;
}

const {
  caption = "The hardware wasn't selected for the job. It was what I had.",
  subcaption = "The local LLM idea is still alive. The current Celeron just strongly disagrees.",
} = Astro.props;
---

<figure class="space-y-3">
  <div class="flex items-center justify-between font-mono text-xs text-ink-light-muted dark:text-ink-dark-muted px-1">
    <span class="text-accent-dark dark:text-accent font-medium tracking-wider uppercase">
      [ HARDWARE: ASUS VIVOPC VM40B ]
    </span>
    <span>HEADLESS · 24/7 OPERATION</span>
  </div>

  <div class="relative rounded-lg overflow-hidden border border-border-light/80 dark:border-border-dark/80 bg-gradient-to-b from-surface-light-muted/60 to-surface-light-card dark:from-[#151922] dark:to-[#0d1016] shadow-sm flex items-center justify-center py-8 sm:py-12 px-6">
    <img
      src="/lab/asus-vivopc.png"
      onerror="this.onerror=null; this.src='/lab/asus-vivopc-placeholder.svg';"
      alt="ASUS VivoPC VM40B server running headless Ubuntu Server and Docker containers in Mexico City"
      class="max-h-[280px] sm:max-h-[320px] w-auto object-contain transition-transform duration-300 hover:scale-[1.02] drop-shadow-xl"
      loading="lazy"
    />
  </div>

  <figcaption class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-xs sm:text-sm text-ink-light-muted dark:text-ink-dark-muted font-mono pt-1 px-1">
    <span class="text-ink-light-secondary dark:text-ink-dark-secondary italic">
      "{caption}"
    </span>
    <span class="text-[0.75rem] text-ink-light-muted dark:text-ink-dark-muted">
      {subcaption}
    </span>
  </figcaption>
</figure>
